#!/usr/bin/env bash
# curl stub — Paperclip /api/health and OpenHands UI.
#   health_fails_left — countdown of 503s on both local health URLs
echo "curl $*" >> "$CALLS_LOG"

out=""; url=""; want_code=0; failonerr=0
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) [ "$2" = '%{http_code}' ] && want_code=1; shift 2 ;;
    -H|--max-time|--connect-timeout|-d|--data-binary|-u|-X) shift 2 ;;
    -[a-zA-Z]*) case "$1" in *f*) failonerr=1 ;; esac; shift ;;
    --*) shift ;;
    *) url="$1"; shift ;;
  esac
done

emit() {
  if [ -n "$out" ]; then
    printf '%s' "$2" > "$out"
  elif [ "$want_code" != "1" ]; then
    printf '%s' "$2"
  fi
  [ "$want_code" = "1" ] && printf '%s' "$1"
  if [ "$failonerr" = "1" ] && [ "$1" -ge 400 ]; then
    echo "curl: (22) The requested URL returned error: $1" >&2
    exit 22
  fi
  exit 0
}

should_fail_health() {
  if [ -f "$STATE_DIR/health_fails_left" ]; then
    left="$(cat "$STATE_DIR/health_fails_left")"
    if [ "$left" -gt 0 ]; then
      echo $((left - 1)) > "$STATE_DIR/health_fails_left"
      return 0
    fi
  fi
  return 1
}

case "$url" in
  */api/health)
    if should_fail_health; then
      emit 503 '{"status":"fail"}'
    fi
    emit 200 '{"status":"ok"}'
    ;;
  */canvas|*/canvas/)
    if should_fail_health; then
      emit 503 'starting'
    fi
    emit 200 '<html>Agent Canvas</html>'
    ;;
  http://127.0.0.1:*/*|https://*/*)
    if should_fail_health; then
      emit 503 'starting'
    fi
    emit 200 '<html>ok</html>'
    ;;
  *)
    emit 200 '{}'
    ;;
esac
