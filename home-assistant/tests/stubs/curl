#!/usr/bin/env bash
# curl stub — fakes the Home Assistant HTTP surface. State in $STATE_DIR:
#
#   conn_refused_left   — countdown of connection refusals. curl exits 7 with
#                         NO output, which is what a cold container really does
#                         and what makes setup.sh's `|| echo 000` produce 000.
#                         Modelling the readiness race as a tidy 503 would be a
#                         lie: HA is not listening at all for the first ~8s.
#                         The Jellyfin deploy failed on exactly this shape.
#   onboarding_user_done — the owner account already exists, i.e. this is a
#                         re-run or a restored .storage. POST
#                         /api/onboarding/users then answers
#                         403 {"message":"User step already done"}, which is
#                         the IDEMPOTENCY SIGNAL, not an error.
#   users_fail=<code>   — force POST /api/onboarding/users to that HTTP code
#   token_no_access_token — /auth/token 200s with an empty access_token
#   analytics_fail=<code> — force the analytics opt-out to that code
#
# Recorded for assertions:
#   users_body          — the JSON body of the users POST
#   token_body          — the form body of the /auth/token POST
#   analytics_body      — the body of the analytics POST
#   issued_codes        — auth_codes handed out, one per line
#   used_codes          — auth_codes already exchanged (single-use enforcement)
#   token_exchanges     — one line per /auth/token call
#
# The auth_code is single-use: measured against 2026.9.1, a second exchange of
# the same code returns 200 with an EMPTY access_token rather than an error. A
# script that exchanges twice gets nothing the second time and must not treat
# that as success.
echo "curl $*" >> "$CALLS_LOG"

method="GET"; out=""; url=""; want_code=0; failonerr=0; body=""; head_only=0

add_body() {  # accumulate, so repeated -d form pairs join with & like curl
  if [ -z "$body" ]; then body="$1"; else body="$body&$1"; fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    -o|--output) out="$2"; shift 2 ;;
    -u|--user) shift 2 ;;
    -w|--write-out) [ "$2" = '%{http_code}' ] && want_code=1; shift 2 ;;
    -d|--data|--data-raw|--data-binary|--data-urlencode)
      piece="$2"
      case "$piece" in @*) piece="$(cat "${piece#@}" 2>/dev/null)" ;; esac
      add_body "$piece"
      shift 2 ;;
    -H|--header|--max-time|--connect-timeout|--retry|--resolve) shift 2 ;;
    -I|--head) head_only=1; shift ;;
    -[a-zA-Z]*)
      case "$1" in *f*) failonerr=1 ;; esac
      case "$1" in *I*) head_only=1 ;; esac
      shift ;;
    --fail) failonerr=1; shift ;;
    --*) shift ;;
    *) url="$1"; shift ;;
  esac
done
: "$method" "$head_only"

emit() {  # emit <http_code> <body>
  if [ -n "$out" ]; then
    printf '%s' "$2" > "$out"
  elif [ "$want_code" != "1" ]; then
    printf '%s' "$2"
  fi
  [ "$want_code" = "1" ] && printf '%s' "$1"
  if [ "$failonerr" = "1" ] && [ "$1" -ge 400 ]; then
    echo "curl: (22) The requested URL returned error: $1" >&2
    exit 22
  fi
  exit 0
}

# countdown FILE -> 0 (and decrements) while there are ticks left.
countdown() {
  local f="$STATE_DIR/$1" left
  [ -f "$f" ] || return 1
  left="$(cat "$f" 2>/dev/null)"
  case "$left" in ''|*[!0-9]*) return 1 ;; esac
  [ "$left" -gt 0 ] || return 1
  echo $((left - 1)) > "$f"
  return 0
}

forced() {  # forced <state-file> -> echoes the code it holds, if any
  local f="$STATE_DIR/$1" v
  [ -f "$f" ] || return 1
  v="$(cat "$f" 2>/dev/null)"
  case "$v" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$v"
  return 0
}

# ---------------------------------------------------------------------------
# Nothing is listening yet — the container is still starting. Real curl prints
# the literal string 000 for -w '%{http_code}' AND exits 7, which is exactly
# the combination setup.sh's `ha()` has to survive: a naive `|| echo 000`
# fallback concatenates with curl's own output and yields "000000".
if countdown conn_refused_left; then
  echo "curl: (7) Failed to connect to 127.0.0.1 port 8123: Connection refused" >&2
  [ "$want_code" = "1" ] && printf '000'
  exit 7
fi

user_done() { [ -f "$STATE_DIR/onboarding_user_done" ]; }
analytics_done() { [ -f "$STATE_DIR/onboarding_analytics_done" ]; }

case "$url" in
  */api/onboarding/users)
    printf '%s\n' "$body" > "$STATE_DIR/users_body"
    if code="$(forced users_fail)"; then
      rm -f "$STATE_DIR/users_fail"
      emit "$code" '{"message":"stubbed users failure"}'
    fi
    # THE IDEMPOTENCY SIGNAL. 403 here means "the owner exists", which on a
    # re-run is success. A deploy that dies on it cannot be run twice.
    # Note this fires even when readiness_hides_user is set, which is the point
    # of that knob: a run that died between creating the account and finishing
    # sees done:false in the readiness payload, POSTs anyway, and must read the
    # 403 as success rather than as a refusal.
    user_done && emit 403 '{"message":"User step already done"}'
    touch "$STATE_DIR/onboarding_user_done"
    code_val="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
    [ -n "$code_val" ] || code_val="fe5045a61d7b4e038e4cc4b210867ffd"
    printf '%s\n' "$code_val" >> "$STATE_DIR/issued_codes"
    emit 200 "{\"auth_code\":\"$code_val\"}"
    ;;

  */api/onboarding/core_config)
    # setup.sh must NEVER call this. With {} it returns 200 and marks the step
    # done, accepting latitude 0 / longitude 0 / time_zone UTC permanently —
    # the UI then never asks again and every sun-based automation is wrong.
    # The stub answers the way the real server does precisely so that the
    # suite's `no_call` assertion is testing the script, not the stub.
    touch "$STATE_DIR/core_config_called"
    emit 200 '{}'
    ;;

  */api/onboarding/analytics)
    printf '%s\n' "$body" > "$STATE_DIR/analytics_body"
    if code="$(forced analytics_fail)"; then
      rm -f "$STATE_DIR/analytics_fail"
      emit "$code" '{"message":"stubbed analytics failure"}'
    fi
    analytics_done && emit 403 '{"message":"Analytics step already done"}'
    touch "$STATE_DIR/onboarding_analytics_done"
    emit 200 '{}'
    ;;

  */api/onboarding|*/api/onboarding/)
    # 200 + a JSON list of steps while any step is open. This is the readiness
    # endpoint, and it is unauthenticated.
    #
    # onboarding_404 models the OTHER healthy shape: once every step is done
    # and HA restarts, it stops registering the onboarding views entirely and
    # this 404s. Both mean "the server is up"; only 000/5xx mean "not yet".
    [ -f "$STATE_DIR/onboarding_404" ] && emit 404 '404: Not Found'
    u=false; a=false
    user_done && u=true
    analytics_done && a=true
    # readiness_hides_user models the race: this run reads the payload before a
    # concurrent run (or a run that died mid-onboarding) has landed the owner,
    # so it sees done:false, POSTs anyway, and gets the 403. One-shot — by the
    # verification pass the server is consistent again, which is what the real
    # server does. A permanent inconsistency would be a genuinely broken
    # instance, and setup.sh is right to fail that.
    if [ -f "$STATE_DIR/readiness_hides_user" ]; then
      u=false
      rm -f "$STATE_DIR/readiness_hides_user"
    fi
    emit 200 "[{\"step\":\"user\",\"done\":$u},{\"step\":\"core_config\",\"done\":false},{\"step\":\"analytics\",\"done\":$a},{\"step\":\"integration\",\"done\":false}]"
    ;;

  */auth/token)
    printf '%s\n' "$body" >> "$STATE_DIR/token_body"
    echo "exchange" >> "$STATE_DIR/token_exchanges"
    grant="$(printf '%s' "$body" | sed -n 's/.*grant_type=\([^&]*\).*/\1/p')"
    code_in="$(printf '%s' "$body" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')"
    [ -n "$code_in" ] || code_in="$(printf '%s' "$body" | sed -n 's/^code=\([^&]*\).*/\1/p')"

    if [ "$grant" = "refresh_token" ]; then
      emit 200 '{"access_token":"eyJ-refreshed","token_type":"Bearer","expires_in":1800}'
    fi

    if [ -f "$STATE_DIR/token_no_access_token" ]; then
      emit 200 '{"access_token":"","token_type":"Bearer","expires_in":1800}'
    fi

    # Single-use. Measured: a second exchange of the same code yields an
    # empty access_token, not an error status.
    if [ -n "$code_in" ] && grep -qx -- "$code_in" "$STATE_DIR/used_codes" 2>/dev/null; then
      emit 200 '{"access_token":"","token_type":"Bearer","expires_in":1800}'
    fi
    [ -n "$code_in" ] && printf '%s\n' "$code_in" >> "$STATE_DIR/used_codes"
    emit 200 '{"access_token":"eyJhbGciOiJIUzI1NiJ9.stub","token_type":"Bearer","refresh_token":"3915ee-stub","expires_in":1800,"ha_auth_provider":"homeassistant"}'
    ;;

  */api/config)
    emit 200 '{"latitude":0,"longitude":0,"time_zone":"Asia/Singapore","version":"2026.9.1","components":["zeroconf","ssdp","dhcp","usb","sun","http"]}'
    ;;

  *:8123|*:8123/|http://127.0.0.1:*/|https://*.ts.net:*/)
    # `/` is a 302 to /lovelace. NOT 200 — a health check written as
    # `curl -fsS <root>` prints nothing and looks like a failure.
    emit 302 ''
    ;;

  *)
    emit 200 '{}'
    ;;
esac
