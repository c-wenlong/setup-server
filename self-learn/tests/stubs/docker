#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm  — exists => `docker ps` fails like a non-docker-group user
#   db_running      — exists => `compose ps` reports the db container up;
#                     written by `compose up`, removed by `compose stop|down`
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    ;;
  compose)
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        # compose --project-directory <dir> <up -d|ps|stop|exec -T db ...>
        for a in "$@"; do
          case "$a" in
            up)        touch "$STATE_DIR/compose_up" "$STATE_DIR/db_running" ;;
            stop|down) rm -f "$STATE_DIR/db_running" ;;
            ps)        [ -f "$STATE_DIR/db_running" ] && echo "cafe0123" ;;
            exec)      exit 0 ;;
          esac
        done
        ;;
    esac
    ;;
esac
exit 0
