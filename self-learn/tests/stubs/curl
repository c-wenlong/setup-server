#!/usr/bin/env bash
# curl stub: health checks succeed; Seafile API calls get canned JSON.
#   $STATE_DIR/seafile_admin_fails — auth-token POST exits 1
#   $STATE_DIR/seafile_user_exists — admin/users POST errors as "exists"
echo "curl $*" >> "$CALLS_LOG"

for a in "$@"; do
  case "$a" in
    *api2/auth-token*)
      [ -f "$STATE_DIR/seafile_admin_fails" ] && exit 1
      echo '{"token":"stub-token-abc123"}'
      exit 0
      ;;
    *api/v2.1/admin/users*)
      if [ -f "$STATE_DIR/seafile_user_exists" ]; then
        echo '{"error_msg":"A user with this email already exists."}' >&2
        exit 1
      fi
      echo '{"email":"self-learn-sync@test","is_active":true}'
      exit 0
      ;;
    *api2/repos*)
      case "$*" in
        *" -X POST "*|*"-X POST"*) echo '{"repo_id":"stub-repo-777"}' ;;
        *) echo '[{"id":"stub-repo-777","name":"self-learn-blobs"}]' ;;
      esac
      exit 0
      ;;
  esac
done
exit 0
