#!/usr/bin/env bash
# tailscale stub. State in $STATE_DIR:
#   backend_state     — override BackendState (default Running)
#   operator          — exists => serve allowed without sudo
#   serve_fails_left  — countdown of forced serve failures (approval-link flow)
#   ts_ip             — override the reported v4 address
#
# The fake address is deliberately NOT this box's real 100.85.87.87. A test
# that passed only because it matched the live tailnet IP would be testing
# nothing, and a stub emitting the real address could not distinguish a
# resolved value from a literal hardcoded in docker-compose.yml or setup.sh.
echo "tailscale $*" >> "$CALLS_LOG"

case "$1" in
  status)
    state="Running"
    [ -f "$STATE_DIR/backend_state" ] && state="$(cat "$STATE_DIR/backend_state")"
    case "$*" in
      *--json*)
        cat <<EOF
{
  "BackendState": "$state",
  "Self": {
    "DNSName": "test-host.tailfake.ts.net."
  }
}
EOF
        ;;
      *) echo "BackendState: $state" ;;
    esac
    ;;
  ip)
    case "$2" in
      -6) echo "fd7a:115c:a1e0::1111:2222" ;;
      *)  cat "$STATE_DIR/ts_ip" 2>/dev/null || echo "100.77.77.77" ;;
    esac
    ;;
  serve)
    case "$*" in
      *status*)
        # Reflects $STATE_DIR/guac_port rather than a literal 8094: setup.sh
        # greps this output for ":$GUAC_PORT", so a hardcoded port made the
        # GUAC_PORT-override scenario fail in the stub rather than in the
        # script — a false red that hides whatever the real behaviour is.
        sp="$(cat "$STATE_DIR/guac_port" 2>/dev/null || echo 8094)"
        echo "https://test-host.tailfake.ts.net:$sp (tailnet only)"
        echo "|-- /  proxy http://127.0.0.1:$sp/guacamole/"
        exit 0 ;;
    esac
    if [ -f "$STATE_DIR/serve_fails_left" ]; then
      left="$(cat "$STATE_DIR/serve_fails_left")"
      if [ "$left" -gt 0 ]; then
        echo $((left - 1)) > "$STATE_DIR/serve_fails_left"
        echo "Serve is not enabled on your tailnet." >&2
        echo "To enable, visit: https://login.tailscale.com/f/serve?node=FAKE" >&2
        exit 1
      fi
    fi
    # Operator gating is a Linux tailscaled concept; macOS has no operator.
    if [ "$(/usr/bin/uname -s)" != "Darwin" ] && [ ! -f "$STATE_DIR/operator" ]; then
      echo "sending serve config: Access denied: serve config denied" >&2
      exit 1
    fi
    # Record the proxy target. The front door's behaviour depends on it: the
    # webapp is deployed under the /guacamole context path, so serving
    # http://127.0.0.1:PORT alone puts a 404 at https://host:PORT/ . The curl
    # stub reads this file so that mistake shows up as a broken front door
    # rather than only as a string that looks slightly different.
    for a in "$@"; do
      case "$a" in http://*) printf '%s\n' "$a" > "$STATE_DIR/serve_target" ;; esac
    done
    echo "Serve started and running in the background."
    ;;
  set)
    case "$2" in
      --operator=*) touch "$STATE_DIR/operator" ;;
    esac
    ;;
  *) exit 0 ;;
esac
