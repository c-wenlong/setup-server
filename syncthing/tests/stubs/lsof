#!/usr/bin/env bash
# lsof stub — the socket-level listener check on macOS, where lsof is the
# ONLY such tool this deploy has. Same $STATE_DIR/listeners state file as the
# ss stub (addr:port per line), so one fixture drives both platforms.
#
# THE PORT COMES FROM THE -i ARGUMENT, AND THE ARGUMENT FORM MATTERS. setup.sh
# asks the way real lsof wants it, per protocol: `-iTCP:<port>` and
# `-iUDP:<port>` (a bare `-i:<port>` is also legal and means both). A stub
# that only understands one of those shapes parses an empty port, matches
# nothing, and emits rows ending in a bare colon — so the wildcard-bind test
# passes because the table was empty, not because the bind was clean. On
# Linux the `ss` stub shadows the missing real `ss` and hides that entirely,
# which is exactly how it went unnoticed.
#
# Real lsof behaviour worth modelling, because setup.sh depends on it:
#   - no match => no output at all (not even the header) and exit 1, which
#     under `set -o pipefail` is enough to kill an unguarded assignment;
#   - -iTCP lists TCP rows only, -iUDP UDP rows only;
#   - without -sTCP:LISTEN, TCP rows include ESTABLISHED connections.
echo "lsof $*" >> "$CALLS_LOG"

port=""; want_tcp=0; want_udp=0; listen_only=0
for a in "$@"; do
  case "$a" in
    -iTCP:*)      want_tcp=1; port="${a#-iTCP:}" ;;
    -iUDP:*)      want_udp=1; port="${a#-iUDP:}" ;;
    -i:*)         want_tcp=1; want_udp=1; port="${a#-i:}" ;;
    -sTCP:LISTEN) listen_only=1 ;;
  esac
done
if [ -z "$port" ]; then
  echo "lsof stub: could not parse a port from: $*" >&2
  exit 1
fi

rows=""
row() { rows="$rows$1
"; }
emit_listener() {  # emit_listener addr:port
  [ "$want_tcp" = "1" ] && row "syncthing 1 user 3u IPv4 0x0 0t0 TCP $1 (LISTEN)"
  [ "$want_udp" = "1" ] && row "syncthing 1 user 4u IPv4 0x0 0t0 UDP $1"
  return 0
}

# A peer's live connection. NOT a listener; a check that counts it as one
# fails a healthy deploy the moment a device connects (Greptile, PR #3).
# Real lsof shows it for a TCP query that is not narrowed to LISTEN, so any
# regression that drops -sTCP:LISTEN (or asks with a bare -i:PORT) meets it.
if [ "$want_tcp" = "1" ] && [ "$listen_only" != "1" ]; then
  row "syncthing 1 user 9u IPv4 0x0 0t0 TCP 100.100.100.100:$port->100.100.100.7:51234 (ESTABLISHED)"
fi

if [ -f "$STATE_DIR/listeners" ]; then
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    case "$a" in *:"$port") emit_listener "$a" ;; esac
  done < "$STATE_DIR/listeners"
else
  emit_listener "100.100.100.100:$port"
fi

[ -n "$rows" ] || exit 1        # nothing matched: no output, exit 1
echo "COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME"
printf '%s' "$rows"
exit 0
