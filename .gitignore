# Per-service secrets — generated by setup.sh, never committed. The * covers
# backups and variants (.env.bak-*, .env.local, ...) so a stray copy can never
# slip in via `git add -A`.
services/*/.env*
# Host-specific Claude/Codex bind-mount overlay (paths into $HOME)
services/openhands/docker-compose.creds.yml
# Per-machine manual-redeploy overlays (host-gateway reachability), same class
# of local-only file as .env
services/*/docker-compose.override.yml
# Same thing at any depth: a compose stack in a subdirectory writes its own.
.env
.env.*

# Python bytecode (py_compile in CI and any local run leaves these behind)
__pycache__/
*.py[cod]

# Coverage artifacts (coverage.py + Codecov upload)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local harness state: agent worktrees and per-machine settings
.claude/

# OS cruft
.DS_Store
