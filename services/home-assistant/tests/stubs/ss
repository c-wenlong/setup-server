#!/usr/bin/env bash
# ss stub: what a correct deploy looks like on this box — HA on loopback only,
# plus tailscaled's own serve frontend on the tailnet addresses (HTTPS port
# equals the local port here, so they collide on one number).
#
# State in $STATE_DIR:
#   wildcard_bind — exists => report 0.0.0.0:8123, i.e. network_mode: host
#                   without http.server_host. That is the leak this repo's
#                   whole security model exists to prevent.
#   port_busy     — exists => something else already holds the port
echo "ss $*" >> "$CALLS_LOG"

port="$(printf '%s' "$*" | sed -n 's/.*sport = :\([0-9]*\).*/\1/p')"
[ -n "$port" ] || port="$(cat "$STATE_DIR/listen_port" 2>/dev/null || echo 8123)"

# The header line is load-bearing: setup.sh reads addresses with
# `awk 'NR>1{print $4}'`, so a stub without a header silently drops its first
# listener and the loopback-only assertion would pass for the wrong reason.
echo "State  Recv-Q Send-Q Local Address:Port  Peer Address:Port  Process"

if [ -f "$STATE_DIR/port_busy" ]; then
  echo "LISTEN 0      128    0.0.0.0:$port 0.0.0.0:* users:((\"nginx\",pid=1,fd=1))"
  exit 0
fi

# Before the container starts nothing is listening.
[ -f "$STATE_DIR/compose_up" ] || exit 0

if [ -f "$STATE_DIR/wildcard_bind" ]; then
  # network_mode: host with no http.server_host — plain HTTP on the LAN.
  echo "LISTEN 0      128    0.0.0.0:$port 0.0.0.0:*"
  exit 0
fi

echo "LISTEN 0      128    127.0.0.1:$port 0.0.0.0:*"
echo "LISTEN 0      128    100.77.77.77:$port 0.0.0.0:*"
exit 0
