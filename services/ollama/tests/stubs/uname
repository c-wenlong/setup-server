#!/usr/bin/env bash
# uname stub: FAKE_OS overrides `uname -s` (to run the macOS branch on Linux);
# FAKE_ARCH overrides `uname -m`; everything else is the real uname.
if [ -n "${FAKE_OS:-}" ] && [ "${1:-}" = "-s" ]; then
  echo "$FAKE_OS"
  exit 0
fi
if [ -n "${FAKE_ARCH:-}" ] && [ "${1:-}" = "-m" ]; then
  echo "$FAKE_ARCH"
  exit 0
fi
PATH=/usr/bin:/bin exec uname "$@"
