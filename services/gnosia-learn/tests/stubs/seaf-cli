#!/usr/bin/env bash
# seaf-cli stub. State in $STATE_DIR:
#   seaf_synced_<repo>  — exists => `list` shows that repo as synced
#   seaf_fail_sync      — exists => `sync` exits 1
echo "seaf-cli $*" >> "$CALLS_LOG"

case "${1:-}" in
  init)
    # -d <dir>: make the ccnet dir so later checks see an initialised client
    while [ $# -gt 0 ]; do
      [ "$1" = "-d" ] && { mkdir -p "$2/ccnet"; shift; }
      shift
    done
    ;;
  start|stop) ;;
  sync)
    [ -f "$STATE_DIR/seaf_fail_sync" ] && exit 1
    # the password arrives piped on stdin (sync.sh never puts it on argv);
    # consume it like the real getpass fallback would
    [ ! -t 0 ] && cat >/dev/null
    repo="" dir=""
    while [ $# -gt 0 ]; do
      [ "$1" = "-l" ] && repo="$2"
      [ "$1" = "-d" ] && dir="$2"
      shift
    done
    [ -n "$repo" ] && touch "$STATE_DIR/seaf_synced_$repo"
    [ -n "$dir" ] && echo "$dir" > "$STATE_DIR/seaf_path_$repo"
    ;;
  desync)
    dir=""
    while [ $# -gt 0 ]; do
      [ "$1" = "-d" ] && dir="$2"
      shift
    done
    for f in "$STATE_DIR"/seaf_path_*; do
      [ -e "$f" ] || continue
      [ "$(cat "$f")" = "$dir" ] && { rm -f "$f" "${f/path_/synced_}"; }
    done
    ;;
  list)
    for f in "$STATE_DIR"/seaf_synced_*; do
      [ -e "$f" ] || continue
      repo="${f##*seaf_synced_}"
      path="$HOME/.self-learn/blobs/local"
      [ -f "$STATE_DIR/seaf_path_$repo" ] && path="$(cat "$STATE_DIR/seaf_path_$repo")"
      # real output: three columns — name, id, synced folder
      echo "gnosia-learn-blobs $repo $path"
    done
    ;;
  status) ;;
esac
exit 0
