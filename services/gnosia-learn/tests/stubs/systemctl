#!/usr/bin/env bash
# systemctl stub: logs and succeeds. Tracks per-unit state in $STATE_DIR:
#   web_active / web_failed  — gnosia-learn.service (is-active / is-failed)
#   seaf_active              — gnosia-learn-seafile.service
#   studio_active            — gnosia-learn-studio.service
#   web_enabled / studio_enabled / seaf_enabled — enable/disable state
# enable --now also marks the unit active; disable --now clears it.
echo "systemctl $*" >> "$CALLS_LOG"

# setup.sh addresses units bare (`gnosia-learn`), deploy.sh with the suffix
# (`gnosia-learn.service`) — normalise so both hit the same marker.
unit="${*: -1}"; unit="${unit%.service}"
marker=""; failed_marker="x_$unit"
case "$unit" in
  gnosia-learn)         marker=web_active;    failed_marker=web_failed ;;
  gnosia-learn-seafile) marker=seaf_active;   failed_marker=seaf_failed ;;
  gnosia-learn-studio)  marker=studio_active; failed_marker=studio_failed ;;
esac
enabled_marker="${marker%_active}_enabled"

# Real systemd runs the unit's ExecStartPre= lines before every start
# ('-' prefix means a failure is ignored; otherwise a failed pre-hook stops
# the start). gnosia-learn.service uses one to clear teardown's torn-down
# marker — running it here keeps a stubbed `start` faithful.
run_pre() {
  local f="$HOME/.config/systemd/user/$1.service" line cmd
  [ -f "$f" ] || return 0
  while IFS= read -r line; do
    cmd="${line#ExecStartPre=}"
    [ -n "$cmd" ] || continue
    case "$cmd" in
      -*) sh -c "${cmd#-}" >/dev/null 2>&1 || true ;;
      *)  sh -c "$cmd" || return 1 ;;
    esac
  done <<PREHOOKS
$(grep '^ExecStartPre=' "$f")
PREHOOKS
}

case "${2:-}" in
  is-active)
    [ -n "$marker" ] && [ -f "$STATE_DIR/$marker" ] && exit 0 || exit 3
    ;;
  is-failed)
    [ -f "$STATE_DIR/$failed_marker" ] && exit 0 || exit 4
    ;;
  is-enabled)
    [ -n "$marker" ] && [ -f "$STATE_DIR/$enabled_marker" ] && exit 0 || exit 1
    ;;
  stop)
    [ -n "$marker" ] && rm -f "$STATE_DIR/$marker"
    ;;
  start|restart)
    if [ -n "$marker" ]; then
      run_pre "$unit" || exit 3
      rm -f "$STATE_DIR/$failed_marker"; touch "$STATE_DIR/$marker"
    fi
    ;;
  enable)
    [ -n "$marker" ] && touch "$STATE_DIR/$enabled_marker"
    # `enable --now UNIT` starts it too
    case "$*" in *--now*) [ -n "$marker" ] && { run_pre "$unit" || exit 3; touch "$STATE_DIR/$marker"; } ;; esac
    ;;
  disable)
    [ -n "$marker" ] && rm -f "$STATE_DIR/$enabled_marker"
    case "$*" in *--now*) [ -n "$marker" ] && rm -f "$STATE_DIR/$marker" ;; esac
    ;;
esac
exit 0
