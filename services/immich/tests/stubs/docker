#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm  — exists => `docker ps` fails like a non-docker-group user
#   ml_container    — exists => `docker ps -a` lists immich_machine_learning
#   compose_up      — touched by `compose ... up`
#   compose_up_ml   — touched by `compose --profile ml ... up`
#   compose_rm_ml   — touched by `compose ... rm -sf immich-machine-learning`
#   compose_stop    — touched by `compose ... stop` (teardown)
#   compose_down    — touched by `compose ... down`; compose_down_v when `-v`
#   docker_run_fails — exists => `docker run --entrypoint sh` (purge cleanup) fails
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    # `docker ps -a --format '{{.Names}}'` — used to detect a stale ML container
    for a in "$@"; do
      if [ "$a" = "-a" ] && [ -f "$STATE_DIR/ml_container" ]; then
        echo "immich_server"
        echo "immich_machine_learning"
      fi
    done
    ;;
  rm)
    # `docker rm -f immich_machine_learning` (fallback path)
    rm -f "$STATE_DIR/ml_container"
    ;;
  run)
    # teardown --purge's cleanup of container-owned files:
    #   docker run --rm --pull never --user 0 -v DIR:/x --entrypoint sh <image> -c 'find ...'
    # The real container is root, so it can delete what the host user cannot.
    # Model that by making the tree writable first, then running the real find.
    mount_host=""; entry=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -v|--volume) mount_host="${2%%:*}"; shift 2 ;;
        --entrypoint) entry="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ "$entry" = "sh" ] && [ -n "$mount_host" ] || exit 0
    [ -f "$STATE_DIR/docker_run_fails" ] && exit 1
    chmod -R u+rwX "$mount_host" 2>/dev/null
    find "$mount_host" -mindepth 1 -delete
    exit $?
    ;;
  compose)
    # Real compose activates a profile from EITHER --profile or the
    # COMPOSE_PROFILES environment variable (env wins over the .env file),
    # so the stub honours both — a stale export must show up as a failure.
    profile=0
    case ",${COMPOSE_PROFILES:-}," in *,ml,*) profile=1 ;; esac
    prev=""
    for a in "$@"; do
      [ "$prev" = "--profile" ] && [ "$a" = "ml" ] && profile=1
      prev="$a"
    done
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        for a in "$@"; do
          case "$a" in
            up)
              touch "$STATE_DIR/compose_up"
              if [ "$profile" = "1" ]; then
                touch "$STATE_DIR/compose_up_ml" "$STATE_DIR/ml_container"
              fi
              ;;
            rm)
              touch "$STATE_DIR/compose_rm_ml"
              rm -f "$STATE_DIR/ml_container"
              ;;
            stop)
              touch "$STATE_DIR/compose_stop"
              ;;
            down)
              touch "$STATE_DIR/compose_down"
              # Like real compose, a profile-gated container only goes when
              # its profile is active.
              [ "$profile" = "1" ] && rm -f "$STATE_DIR/ml_container"
              ;;
            -v)
              touch "$STATE_DIR/compose_down_v"
              ;;
          esac
        done
        ;;
    esac
    ;;
esac
exit 0
