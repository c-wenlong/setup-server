#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm  — exists => `docker ps` fails like a non-docker-group user
#   compose_up / compose_down — touched by `compose ... up` / `down`
#   docker_run_fails — exists => `docker run --entrypoint sh` (purge cleanup) fails
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    ;;
  compose)
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        # compose --project-directory <dir> up -d  (and ps/logs/etc.)
        for a in "$@"; do
          [ "$a" = "up" ] && touch "$STATE_DIR/compose_up"
          [ "$a" = "down" ] && touch "$STATE_DIR/compose_down"
        done
        ;;
    esac
    ;;
  run)
    # teardown --purge's cleanups of root-owned files:
    #   docker run --rm --pull never -v DIR:/purge --entrypoint sh <image> \
    #     -c 'find /purge -mindepth 1 -delete'
    #   docker run --rm --pull never -v BASE:/x --entrypoint sh <image> \
    #     -c SCRIPT sh REST          (data behind an unsearchable folder)
    # The real container is root, so it can delete what the host user
    # cannot. Model that by making the mounted tree accessible first, then
    # running the real SCRIPT on the host with the mount point pointing at
    # the host side of the mount.
    entry=""; mount_host=""; mount_ctr=""; script=""; prev=""
    argv="$*"
    while [ $# -gt 0 ]; do
      case "$prev" in
        --entrypoint) entry="$1" ;;
        -v) mount_host="${1%%:*}"; mount_ctr="${1#*:}" ;;
        -c) script="$1"; shift; break ;;
      esac
      prev="$1"; shift
    done
    [ "$entry" = "sh" ] || exit 0
    printf '%s\n' "$argv" >> "$STATE_DIR/cleanup_run"
    [ -f "$STATE_DIR/docker_run_fails" ] && exit 1
    [ -n "$mount_host" ] && [ -n "$mount_ctr" ] && [ -n "$script" ] || exit 1
    chmod -R u+rwX "$mount_host" 2>/dev/null
    sh -c "${script//"$mount_ctr"/$mount_host}" "$@"
    exit $?
    ;;
esac
exit 0
