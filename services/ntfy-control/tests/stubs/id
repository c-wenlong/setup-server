#!/usr/bin/env bash
# id stub: FAKE_UID overrides the reported uid (for the run-as-root test).
if [ "${1:-}" = "-u" ]; then
  echo "${FAKE_UID:-1000}"
elif [ "${1:-}" = "-nG" ]; then
  # deterministic groups for the sg-wrapper branch in setup.sh
  echo "kaichen adm docker"
else
  /usr/bin/id "$@"
fi
