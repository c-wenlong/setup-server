#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm   — exists => `docker ps` fails like a non-docker-group user
#   compose_up       — touched by `compose ... up`
#   compose_down     — touched by `compose ... down`
#   docker_run_fails — exists => `docker run --entrypoint sh` (purge cleanup) fails
#   compose_down_fails — exists => `compose ... down` exits 1 like Compose when
#                      a container outside the project still uses seafile-net
#   project_left     — exists => `docker ps -aq --filter label=com.docker.compose.project=…`
#                      prints it (this project's containers a failed down left)
#   ps_label_fails   — exists => that labelled `docker ps` fails
#   network_users_<net> — exists => `docker network inspect … <net>` succeeds
#                      and prints it (else: no such network)
#   mounted_missing  — touched when a cleanup `docker run -v SRC:…` names a
#                      SRC that does not exist (real dockerd would create it as root)
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    case " $* " in
      *" label=com.docker.compose.project="*)
        [ -f "$STATE_DIR/ps_label_fails" ] && { echo "Error response from daemon" >&2; exit 1; }
        [ -f "$STATE_DIR/project_left" ] && cat "$STATE_DIR/project_left"
        ;;
    esac
    ;;
  network)
    # docker network inspect -f '{{range .Containers}}{{.Name}} {{end}}' <net>
    [ "${2:-}" = "inspect" ] || exit 0
    for net in "$@"; do :; done
    [ -f "$STATE_DIR/network_users_$net" ] || { echo "Error response from daemon: network $net not found" >&2; exit 1; }
    cat "$STATE_DIR/network_users_$net"
    ;;
  compose)
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        # compose --project-directory <dir> up -d  (and ps/logs/etc.)
        for a in "$@"; do
          case "$a" in
            up)   touch "$STATE_DIR/compose_up" ;;
            down)
              if [ -f "$STATE_DIR/compose_down_fails" ]; then
                echo "failed to remove network seafile-net: Error response from daemon: error while removing network: network seafile-net has active endpoints" >&2
                exit 1
              fi
              touch "$STATE_DIR/compose_down" ;;
          esac
        done
        ;;
    esac
    ;;
  run)
    # teardown --purge's cleanups of container-owned files:
    #   docker run --rm --pull never -v DIR:/x --entrypoint sh IMAGE -c 'find /x -mindepth 1 -delete'
    #   docker run --rm --pull never -v BASE:/x --entrypoint sh IMAGE -c SCRIPT sh REST
    #                                       (data behind an unsearchable folder)
    # The real container is root, so it can delete what the host user cannot.
    # Model that by making the mounted tree accessible first, then running the
    # real SCRIPT on the host with the mount point replaced by the host path.
    mount_host=""; mount_ctr=""; entry=""; script=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -v|--volume) mount_host="${2%%:*}"; mount_ctr="${2#*:}"; shift 2 ;;
        --entrypoint) entry="$2"; shift 2 ;;
        -c) script="$2"; shift 2; break ;;
        *) shift ;;
      esac
    done
    [ "$entry" = "sh" ] || exit 0
    [ -f "$STATE_DIR/docker_run_fails" ] && exit 1
    [ -n "$mount_host" ] && [ -n "$mount_ctr" ] && [ -n "$script" ] || exit 1
    [ -d "$mount_host" ] || { touch "$STATE_DIR/mounted_missing"; exit 1; }
    chmod -R u+rwX "$mount_host" 2>/dev/null
    sh -c "${script//"$mount_ctr"/$mount_host}" "$@"
    exit $?
    ;;
esac
exit 0
