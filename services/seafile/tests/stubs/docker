#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm   — exists => `docker ps` fails like a non-docker-group user
#   compose_up       — touched by `compose ... up`
#   compose_down     — touched by `compose ... down`
#   docker_run_fails — exists => `docker run --entrypoint sh` (purge cleanup) fails
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    ;;
  compose)
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        # compose --project-directory <dir> up -d  (and ps/logs/etc.)
        for a in "$@"; do
          case "$a" in
            up)   touch "$STATE_DIR/compose_up" ;;
            down) touch "$STATE_DIR/compose_down" ;;
          esac
        done
        ;;
    esac
    ;;
  run)
    # teardown --purge's container-owned-file cleanup:
    #   docker run --rm --pull never -v DIR:/x --entrypoint sh IMAGE -c 'find /x -mindepth 1 -delete'
    # The real container is root, so it can delete what the host user cannot.
    # Model that by making the tree writable first, then running the real find.
    mount_host=""; entry=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -v|--volume) mount_host="${2%%:*}"; shift 2 ;;
        --entrypoint) entry="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ "$entry" = "sh" ] || exit 0
    [ -f "$STATE_DIR/docker_run_fails" ] && exit 1
    [ -n "$mount_host" ] && [ -d "$mount_host" ] || exit 1
    chmod -R u+rwX "$mount_host" 2>/dev/null
    find "$mount_host" -mindepth 1 -delete
    exit $?
    ;;
esac
exit 0
