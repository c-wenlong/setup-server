#!/usr/bin/env bash
# tailscale stub. State in $STATE_DIR:
#   backend_state     — override BackendState (default Running)
#   operator          — exists => serve allowed without sudo
#   serve_fails_left  — countdown of forced serve failures (approval-link flow)
#   ts_ip             — override the tailnet IPv4 (default 100.100.100.100)
#   no_ts_ip          — exists => `tailscale ip -4` prints nothing and fails
#   serve_status      — text `tailscale serve status` prints (teardown tests)
#   serve_status_fails — exists => `serve status` fails like a stopped daemon
echo "tailscale $*" >> "$CALLS_LOG"

if [ "$1" = "serve" ] && [ "${2:-}" = "status" ]; then
  if [ -f "$STATE_DIR/serve_status_fails" ]; then
    echo "failed to connect to local tailscaled" >&2
    exit 1
  fi
  [ -f "$STATE_DIR/serve_status" ] && cat "$STATE_DIR/serve_status"
  exit 0
fi
case " $* " in *" off "*) [ "$1" = "serve" ] && exit 0 ;; esac

case "$1" in
  status)
    state="Running"
    [ -f "$STATE_DIR/backend_state" ] && state="$(cat "$STATE_DIR/backend_state")"
    cat <<JSON
{
  "BackendState": "$state",
  "Self": {
    "DNSName": "test-host.tailfake.ts.net."
  }
}
JSON
    ;;
  ip)
    [ -f "$STATE_DIR/no_ts_ip" ] && exit 1
    case "${2:-}" in
      -6) echo "fd7a:115c:a1e0::1234" ;;
      *)  if [ -f "$STATE_DIR/ts_ip" ]; then cat "$STATE_DIR/ts_ip"; else echo "100.100.100.100"; fi ;;
    esac
    ;;
  serve)
    if [ -f "$STATE_DIR/serve_fails_left" ]; then
      left="$(cat "$STATE_DIR/serve_fails_left")"
      if [ "$left" -gt 0 ]; then
        echo $((left - 1)) > "$STATE_DIR/serve_fails_left"
        echo "Serve is not enabled on your tailnet." >&2
        echo "To enable, visit: https://login.tailscale.com/f/serve?node=FAKE" >&2
        exit 1
      fi
    fi
    if [ "$(uname -s)" != "Darwin" ] && [ ! -f "$STATE_DIR/operator" ]; then
      echo "sending serve config: Access denied: serve config denied" >&2
      exit 1
    fi
    echo "Serve started and running in the background."
    ;;
  set)
    case "$2" in --operator=*) touch "$STATE_DIR/operator" ;; esac
    ;;
  *) exit 0 ;;
esac
