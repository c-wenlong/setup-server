#!/usr/bin/env bash
# stat stub: when $STATE_DIR/sudo_chown records a prior `sudo chown 10001:10001 <dir>`,
# `stat -c %u <dir>` / `stat -f %u <dir>` reports 10001; before chown it reports 1000.
if { [ "${1:-}" = "-c" ] || [ "${1:-}" = "-f" ]; } && [ "${2:-}" = "%u" ]; then
  if grep -qF "chown 10001:10001 ${3:-}" "$STATE_DIR/sudo_chown" 2>/dev/null; then
    echo 10001
  else
    echo 1000
  fi
  exit 0
fi
PATH=/usr/bin:/bin exec stat "$@"
