#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm   — exists => `docker ps` fails like a non-docker-group user
#   compose_up       — touched by `compose ... up`
#   compose_down     — touched by `compose ... down`
#   containers       — what `docker ps -a --format ...` prints (teardown
#                      tests), one `name|compose-project` line per container
#   ps_list_fails    — exists => that listing fails
#   docker_run_fails — exists => `docker run --entrypoint sh` (purge cleanup) fails
#   compose_config_json — what `compose ... config --format json` prints; when
#                      absent, config fails like a Compose without --format,
#                      so teardown falls back to reading the creds overlay
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    for a in "$@"; do
      if [ "$a" = "--format" ]; then
        [ ! -f "$STATE_DIR/ps_list_fails" ] || { echo "error listing containers" >&2; exit 1; }
        [ ! -f "$STATE_DIR/containers" ] || cat "$STATE_DIR/containers"
        exit 0
      fi
    done
    echo "openhands-agent-canvas"
    ;;
  inspect)
    echo running
    ;;
  run)
    # teardown --purge's cleanup of files the container user owns: the real
    # container runs as root, so it can delete what the host user cannot.
    # Model that by making the mounted tree writable, then running the real
    # `find ... -delete` on the host path.
    mount_host=""; entry=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -v|--volume) mount_host="${2%%:*}"; shift 2 ;;
        --entrypoint) entry="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [ "$entry" = "sh" ] || exit 0
    [ ! -f "$STATE_DIR/docker_run_fails" ] || exit 1
    [ -n "$mount_host" ] && [ -d "$mount_host" ] || exit 1
    chmod -R u+rwX "$mount_host" 2>/dev/null
    find "$mount_host" -mindepth 1 -delete
    exit $?
    ;;
  compose)
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        for a in "$@"; do
          case "$a" in
            up)   touch "$STATE_DIR/compose_up" ;;
            pull) touch "$STATE_DIR/compose_pull" ;;
            down) touch "$STATE_DIR/compose_down" ;;
            config)
              [ -f "$STATE_DIR/compose_config_json" ] || { echo "unknown flag: --format" >&2; exit 1; }
              cat "$STATE_DIR/compose_config_json"
              exit 0
              ;;
          esac
        done
        ;;
    esac
    ;;
esac
exit 0
