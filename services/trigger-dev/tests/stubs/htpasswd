#!/usr/bin/env bash
# htpasswd stub: `htpasswd -Bni USER` reads the password on stdin (-i), so
# argv must only carry the username. $STATE_DIR/no_htpasswd simulates a host
# without a usable htpasswd binary (even on CI runners with apache2-utils).
[ -f "$STATE_DIR/no_htpasswd" ] && exit 127
echo "htpasswd $*" >> "$CALLS_LOG"
cat >/dev/null
printf '%s\n' "${2:-registry-user}:\$2y\$05\$stubhashfortriggerdevregistryauth"
