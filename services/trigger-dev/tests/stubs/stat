#!/usr/bin/env bash
# stat stub: before the sudo stub's chown ran, report uid 1000 even on CI
# runners whose own account is uid 1001; after chown ($STATE_DIR/minio_chowned),
# report uid 1001. Everything else (-c %a / -f %Lp) defers to the real stat.
if { [ "${1:-}" = "-c" ] || [ "${1:-}" = "-f" ]; } && [ "${2:-}" = "%u" ]; then
  if [ -f "$STATE_DIR/minio_chowned" ]; then
    echo 1001
  else
    echo 1000
  fi
  exit 0
fi
PATH=/usr/bin:/bin exec stat "$@"
