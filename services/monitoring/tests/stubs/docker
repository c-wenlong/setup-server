#!/usr/bin/env bash
# docker stub. State in $STATE_DIR:
#   docker_no_perm  — exists => `docker ps` fails like a non-docker-group user
#   ntfy_users      — one username per line: what `docker exec ntfy ntfy user
#                     list` reports and `user add` appends to (pre-seed it to
#                     simulate an auth db that already has the accounts)
echo "docker $*" >> "$CALLS_LOG"

case "$1" in
  ps)
    if [ -f "$STATE_DIR/docker_no_perm" ]; then
      echo "permission denied while trying to connect to the docker API" >&2
      exit 1
    fi
    ;;
  exec)
    # docker exec [-e K=V ...] <container> <binary> <args> — only ntfy's own
    # CLI is emulated, matching real output:
    #   user list  -> "user <name> (role: user, tier: none)" per line
    #   user add   -> appends to ntfy_users, prints "user <name> added ..."
    #   access     -> upsert; the calls.log entry above is the record
    shift
    while [ "${1:-}" = "-e" ]; do shift 2; done
    shift 2  # container + binary
    case "${1:-}" in
      user)
        case "${2:-}" in
          list)
            if [ -f "$STATE_DIR/ntfy_users" ]; then
              while read -r u; do echo "user $u (role: user, tier: none)"; done < "$STATE_DIR/ntfy_users"
            fi
            ;;
          add)
            u="${!#}"
            echo "$u" >> "$STATE_DIR/ntfy_users"
            echo "user $u added with role user"
            ;;
          change-pass)
            # succeeds; the calls.log entry above is the record the suite
            # asserts on (setup.sh re-syncs .env passwords every run)
            ;;
        esac
        ;;
    esac
    ;;
  compose)
    case "$2" in
      version) echo "Docker Compose version v2.99-stub" ;;
      *)
        # compose --project-directory <dir> up -d  (and ps/logs/etc.)
        for a in "$@"; do
          [ "$a" = "up" ] && touch "$STATE_DIR/compose_up"
        done
        ;;
    esac
    ;;
esac
exit 0
