#!/usr/bin/env bash
# tailscale stub. State lives in $STATE_DIR:
#   backend_state       — override BackendState (default Running)
#   operator            — exists => serve allowed without sudo
#   serve_fails_left    — countdown of forced serve failures (approval-link flow)
#   no_ts_ip            — exists => `tailscale ip -4` prints nothing and fails,
#                         i.e. tailscale0 has no address yet. This is NOT a
#                         hypothetical: the DNS ports bind to a specific IP and
#                         that bind is impossible without one, so the deploy has
#                         to refuse rather than fall back to a wildcard.
#   ts_ip               — override the reported v4 address (default 100.77.77.77)
#   serve_status        — text `tailscale serve status` prints (teardown tests)
#   serve_status_fails  — exists => `serve status` fails like a stopped daemon
#   dns_status          — JSON `tailscale dns status --json` prints (teardown's
#                         DNS gate). Absent => a logged-in node whose tailnet
#                         lists no resolvers at all (all four keys null, as
#                         the real CLI prints them).
#   dns_status_fails    — exists => `dns status` fails ("no netmap", i.e. 503
#                         from the local API, or a CLI without the subcommand)
#
# The fake address is deliberately made up: a test that passes only because it
# matched the live tailnet IP would be testing nothing, and a stub that emitted
# a real address could not tell a resolved value from a hardcoded literal in
# docker-compose.yml.
echo "tailscale $*" >> "$CALLS_LOG"

if [ "$1" = "serve" ] && [ "${2:-}" = "status" ]; then
  if [ -f "$STATE_DIR/serve_status_fails" ]; then
    echo "failed to connect to local tailscaled" >&2
    exit 1
  fi
  [ -f "$STATE_DIR/serve_status" ] && cat "$STATE_DIR/serve_status"
  exit 0
fi
case " $* " in *" off "*) [ "$1" = "serve" ] && exit 0 ;; esac

if [ "$1" = "dns" ] && [ "${2:-}" = "status" ]; then
  if [ -f "$STATE_DIR/dns_status_fails" ]; then
    echo "503 Service Unavailable: no netmap" >&2
    exit 1
  fi
  if [ -f "$STATE_DIR/dns_status" ]; then
    cat "$STATE_DIR/dns_status"
  else
    cat <<'JSON'
{
  "TailscaleDNS": true,
  "CurrentTailnet": {
    "MagicDNSEnabled": true,
    "MagicDNSSuffix": "tailfake.ts.net",
    "SelfDNSName": "test-host.tailfake.ts.net."
  },
  "Resolvers": null,
  "SplitDNSRoutes": null,
  "FallbackResolvers": null,
  "Nameservers": null
}
JSON
  fi
  exit 0
fi

case "$1" in
  status)
    state="Running"
    [ -f "$STATE_DIR/backend_state" ] && state="$(cat "$STATE_DIR/backend_state")"
    cat <<EOF
{
  "BackendState": "$state",
  "Self": {
    "DNSName": "test-host.tailfake.ts.net."
  }
}
EOF
    ;;
  ip)
    if [ -f "$STATE_DIR/no_ts_ip" ]; then
      echo "no current Tailscale address" >&2
      exit 1
    fi
    case "${2:-}" in
      -6) echo "fd7a:115c:a1e0::1111:2222" ;;
      -4) cat "$STATE_DIR/ts_ip" 2>/dev/null || echo "100.77.77.77" ;;
      # Bare `tailscale ip`: every address, v4 first, as the real CLI does.
      *)  cat "$STATE_DIR/ts_ip" 2>/dev/null || echo "100.77.77.77"
          echo "fd7a:115c:a1e0::1111:2222" ;;
    esac
    ;;
  serve)
    if [ -f "$STATE_DIR/serve_fails_left" ]; then
      left="$(cat "$STATE_DIR/serve_fails_left")"
      if [ "$left" -gt 0 ]; then
        echo $((left - 1)) > "$STATE_DIR/serve_fails_left"
        echo "Serve is not enabled on your tailnet." >&2
        echo "To enable, visit: https://login.tailscale.com/f/serve?node=FAKE" >&2
        exit 1
      fi
    fi
    # Operator gating is a Linux tailscaled concept; macOS has no operator.
    if [ "$(uname -s)" != "Darwin" ] && [ ! -f "$STATE_DIR/operator" ]; then
      echo "sending serve config: Access denied: serve config denied" >&2
      exit 1
    fi
    echo "Serve started and running in the background."
    ;;
  set)
    case "$2" in
      --operator=*) touch "$STATE_DIR/operator" ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
