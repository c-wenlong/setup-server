#!/usr/bin/env bash
# lsof stub — the macOS side of setup.sh's listener audit, reached only when
# `ss` is absent. Mirrors the ss stub's picture so neither branch of that
# fallback can pass while the other would fail.
#
# The behaviour that matters here is the EXIT CODE: real lsof exits 1 when
# nothing matches, and "nothing is listening on this port" is a legitimate
# answer the caller already treats as "nothing bad". Under `set -o pipefail`
# that non-zero status is enough to kill an unguarded assignment, so a stub
# that helpfully exited 0 would hide a real portability bug.
#
# Output shape matches `lsof -nP -iTCP:<port> -sTCP:LISTEN`: a header line,
# then rows whose 9th field is the NAME (addr:port).
#
# Shares $STATE_DIR flags with the ss stub: listen_dns_wildcard,
# listen_dns_lan, listen_web_lan, ts_ip, web_port.
echo "lsof $*" >> "$CALLS_LOG"

port=""; proto=""
for a in "$@"; do
  case "$a" in
    -iTCP:*) proto=tcp; port="${a#-iTCP:}" ;;
    -iUDP:*) proto=udp; port="${a#-iUDP:}" ;;
  esac
done
[ -n "$port" ] || exit 1

ts_ip="$(cat "$STATE_DIR/ts_ip" 2>/dev/null || echo 100.77.77.77)"
web_port="$(cat "$STATE_DIR/web_port" 2>/dev/null || echo 3080)"

rows=""
add() { rows="$rows
AdGuardH 1 admin 5u IPv4 1 0t0 ${proto:-tcp} $1:$port (LISTEN)"; }

if [ "$port" = "53" ]; then
  add "127.0.0.53"
  add "127.0.0.54"
  if [ -f "$STATE_DIR/listen_dns_wildcard" ]; then
    add "*"
  elif [ -f "$STATE_DIR/listen_dns_lan" ]; then
    add "192.168.1.42"
  else
    add "$ts_ip"
  fi
elif [ "$port" = "$web_port" ]; then
  if [ -f "$STATE_DIR/listen_web_lan" ]; then
    add "192.168.1.42"
  else
    add "127.0.0.1"
  fi
fi

# Nothing matched: exit 1 with no output, exactly as lsof does.
[ -n "$rows" ] || exit 1

echo "COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME"
printf '%s\n' "$rows" | sed '/^$/d'
exit 0
