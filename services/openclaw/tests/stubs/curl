#!/usr/bin/env bash
# curl stub — fakes the OpenClaw Gateway HTTP surface. State in $STATE_DIR:
#   health_fails_left  — countdown of 503s from / (models a slow boot)
#
# Understands the flag shapes setup.sh actually uses: bundled -fsS, -o,
# --max-time.
echo "curl $*" >> "$CALLS_LOG"

out=""; url=""; failonerr=0
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -H|--max-time|--connect-timeout|-u|-w|-d|--data-binary|-X) shift 2 ;;
    -[a-zA-Z]*) case "$1" in *f*) failonerr=1 ;; esac; shift ;;
    --*) shift ;;
    *) url="$1"; shift ;;
  esac
done

emit() {  # emit <http_code> <body>
  if [ -n "$out" ]; then
    printf '%s' "$2" > "$out"
  else
    printf '%s' "$2"
  fi
  if [ "$failonerr" = "1" ] && [ "$1" -ge 400 ]; then
    echo "curl: (22) The requested URL returned error: $1" >&2
    exit 22
  fi
  exit 0
}

if [ -f "$STATE_DIR/health_fails_left" ]; then
  left="$(cat "$STATE_DIR/health_fails_left")"
  if [ "$left" -gt 0 ]; then
    echo $((left - 1)) > "$STATE_DIR/health_fails_left"
    emit 503 ''
  fi
fi
# The Control UI serves a 200 shell on / (token login happens in the page).
emit 200 '<html><title>OpenClaw</title></html>'
