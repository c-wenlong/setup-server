#!/usr/bin/env bash
# npm stub: `npm ci` creates node_modules in the cwd; `npm run build` creates
# apps/web/.next; `npm run catalog`/`npm run start` only log.
# $STATE_DIR/build_fails => `npm run build` exits 1 (for the rollback test).
# Inside tools/tldrawkc, `npm run build` emits dist/ instead, and
# $STATE_DIR/tldrawkc_build_fails => it clobbers dist/ and exits 1.
echo "npm $*" >> "$CALLS_LOG"
# sync.sh's blob audit must run against the .env-derived paths — record the
# env it was invoked with so a test can check CATALOG_DB/GNOSIA_HOME were set.
case "$*" in
  *"blob audit"*)
    printf 'CATALOG_DB=%s\nGNOSIA_HOME=%s\nDATABASE_URL=%s\n' \
      "${CATALOG_DB:-}" "${GNOSIA_HOME:-}" "${DATABASE_URL:-}" >> "$STATE_DIR/catalog_env.log"
    if [ -f "$STATE_DIR/audit_fails" ]; then
      echo "blob audit: 3 objects missing" >&2
      exit 1
    fi
    ;;
esac

case "$PWD" in
  */tools/tldrawkc)
    if [ "${1:-}" = "run" ] && [ "${2:-}" = "build" ]; then
      rm -rf dist; mkdir -p dist
      if [ -f "$STATE_DIR/tldrawkc_build_fails" ]; then
        echo "partial" > dist/partial
        echo "npm ERR! tldrawkc build failed" >&2
        exit 1
      fi
      echo "built" > dist/marker
      exit 0
    fi
    ;;
esac

case "${1:-}" in
  ci) mkdir -p node_modules ;;
  run)
    case "${2:-}" in
      build)
        if [ -f "$STATE_DIR/build_fails" ]; then
          echo "npm ERR! next build failed" >&2
          exit 1
        fi
        mkdir -p apps/web/.next
        ;;
    esac
    ;;
esac
exit 0
