#!/usr/bin/env bash
# scp stub — logs; for a remote->local pull it writes a canned dump so the
# rest of the pipeline has bytes to move.
echo "scp $*" >> "$CALLS_LOG"
[ -f "$STATE_DIR/mac_unreachable" ] && exit 1

src="${*: -2:1}"; dst="${*: -1}"
case "$src" in
  *:*) echo "STUB-DUMP" > "$dst" ;;   # remote -> local
esac
exit 0
