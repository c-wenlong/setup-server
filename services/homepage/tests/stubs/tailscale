#!/usr/bin/env bash
# tailscale stub. State lives in $STATE_DIR:
#   backend_state    — override BackendState (default Running)
#   no_dnsname       — DNSName comes back empty, i.e. MagicDNS is off. On THIS
#                      service that is fatal rather than cosmetic: the MagicDNS
#                      name is what goes into HOMEPAGE_ALLOWED_HOSTS, and
#                      without it every tailnet /api/* request returns 400
#                      while the page keeps returning 200.
#   operator         — exists => serve allowed without sudo
#   serve_fails_left — countdown of forced serve failures (approval-link flow)
#   serve_status     — text `tailscale serve status` prints (teardown tests)
#   serve_status_fails — exists => `serve status` fails like a stopped daemon
#   ts_ip            — override the reported v4 address (default 100.77.77.77)
#
# The fake tailnet name and address are deliberately NOT this box's real ones
# (kai-home-server.taild6a23f.ts.net / 100.85.87.87). A suite that passed
# because a literal in setup.sh happened to match the live tailnet would be
# testing nothing, and the allowlist assertions below are precisely about a
# value being *resolved* rather than assumed.
echo "tailscale $*" >> "$CALLS_LOG"

if [ "$1" = "serve" ] && [ "${2:-}" = "status" ]; then
  if [ -f "$STATE_DIR/serve_status_fails" ]; then
    echo "failed to connect to local tailscaled" >&2
    exit 1
  fi
  [ -f "$STATE_DIR/serve_status" ] && cat "$STATE_DIR/serve_status"
  exit 0
fi
case " $* " in *" off "*) [ "$1" = "serve" ] && exit 0 ;; esac

case "$1" in
  status)
    state="Running"
    [ -f "$STATE_DIR/backend_state" ] && state="$(cat "$STATE_DIR/backend_state")"
    if [ -f "$STATE_DIR/no_dnsname" ]; then
      cat <<EOF
{
  "BackendState": "$state",
  "Self": {
    "HostName": "test-host"
  }
}
EOF
    else
      cat <<EOF
{
  "BackendState": "$state",
  "Self": {
    "DNSName": "test-host.tailfake.ts.net."
  }
}
EOF
    fi
    ;;
  ip)
    case "$2" in
      -6) echo "fd7a:115c:a1e0::1111:2222" ;;
      *)  cat "$STATE_DIR/ts_ip" 2>/dev/null || echo "100.77.77.77" ;;
    esac
    ;;
  serve)
    if [ -f "$STATE_DIR/serve_fails_left" ]; then
      left="$(cat "$STATE_DIR/serve_fails_left")"
      if [ "$left" -gt 0 ]; then
        echo $((left - 1)) > "$STATE_DIR/serve_fails_left"
        echo "Serve is not enabled on your tailnet." >&2
        echo "To enable, visit: https://login.tailscale.com/f/serve?node=FAKE" >&2
        exit 1
      fi
    fi
    # Operator gating is a Linux tailscaled concept; macOS has no operator.
    if [ "$(uname -s)" != "Darwin" ] && [ ! -f "$STATE_DIR/operator" ]; then
      echo "sending serve config: Access denied: serve config denied" >&2
      exit 1
    fi
    # Record the mapping. The ss stub reads this to decide whether tailscaled's
    # own proxy is listening on the tailnet address for that port — which is
    # the one non-loopback listener the audit must ACCEPT rather than flag.
    # served_target is the backend port from the proxy URL: the curl stub uses
    # it so that a Serve mapping pointing somewhere the container is not
    # listening cannot answer anyway.
    for a in "$@"; do
      case "$a" in
        --https=*) echo "${a#--https=}" > "$STATE_DIR/served_port" ;;
        http://127.0.0.1:*) echo "${a##*:}" > "$STATE_DIR/served_target" ;;
      esac
    done
    echo "Serve started and running in the background."
    ;;
  set)
    case "$2" in
      --operator=*) touch "$STATE_DIR/operator" ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
