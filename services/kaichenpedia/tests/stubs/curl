#!/usr/bin/env bash
# curl stub: health checks succeed. When asked for an http_code write-out,
# prints 200 (the script greps for a 2xx/3xx).
echo "curl $*" >> "$CALLS_LOG"

# /api/* answers like the kaichenpedia-api sidecar: a JSON error body proves
# the nginx proxy reached the sidecar (vs the static server's HTML 404).
for a in "$@"; do
  case "$a" in
    *"/api/"*) printf '{"error":"invalid path"}'; exit 0 ;;
  esac
done
for a in "$@"; do
  if [ "$a" = "%{http_code}" ]; then
    printf '200'
    exit 0
  fi
done
exit 0
