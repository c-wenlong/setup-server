#!/usr/bin/env bash
# curl stub: health checks succeed. When asked for an http_code write-out,
# prints 200 (the script greps for a 2xx/3xx). State in $STATE_DIR:
#   fail_ports  — ports whose loopback requests fail (see below)
echo "curl $*" >> "$CALLS_LOG"

# fail_ports: one port per line; requests to http://127.0.0.1:<port>/ fail,
# like a container that never answers. 49153 is the probe (docker stub).
if [ -f "$STATE_DIR/fail_ports" ]; then
  while read -r port; do
    for a in "$@"; do
      case "$a" in "http://127.0.0.1:$port/"*) exit 7 ;; esac
    done
  done < "$STATE_DIR/fail_ports"
fi

# /api/* answers like the app's route handlers: a JSON error body.
for a in "$@"; do
  case "$a" in
    *"/api/"*) printf '{"error":"invalid path"}'; exit 0 ;;
  esac
done
for a in "$@"; do
  if [ "$a" = "%{http_code}" ]; then
    printf '200'
    exit 0
  fi
done
exit 0
