#!/usr/bin/env bash
# git stub. State in $STATE_DIR:
#   remote_sha       — sha reported for origin/BRANCH (default aaa1111);
#                      change it between runs to simulate a push
#   git_auth_fail    — exists => ls-remote fails like missing credentials
echo "git $*" >> "$CALLS_LOG"

if [ "${1:-}" = "-C" ]; then shift 2; fi

case "${1:-}" in
  ls-remote)
    if [ -f "$STATE_DIR/git_auth_fail" ]; then
      echo "fatal: could not read Username for 'https://github.com': terminal prompts disabled" >&2
      exit 128
    fi
    printf '%s\trefs/heads/main\n' "$(cat "$STATE_DIR/remote_sha" 2>/dev/null || echo aaa1111)"
    ;;
  clone)
    # last argument is the target directory; fake a kaichenpedia checkout
    target=""
    for a in "$@"; do target="$a"; done
    mkdir -p "$target/.git" "$target/wiki" "$target/scripts" "$target/site"
    echo "# home" > "$target/wiki/index.md"
    echo "fake-lockfile-v1" > "$target/site/package-lock.json"
    echo "sync stub" > "$target/scripts/sync_wiki_to_site.py"
    ;;
  rev-parse)
    cat "$STATE_DIR/remote_sha" 2>/dev/null || echo aaa1111
    ;;
  merge-base)
    # --is-ancestor <sha> <head>: true only when <sha> is the known ref tip
    [ "$3" = "$(cat "$STATE_DIR/remote_sha" 2>/dev/null || echo aaa1111)" ] && exit 0 || exit 1
    ;;
  fetch|reset) ;;
esac
exit 0
