#!/usr/bin/env bash
# git stub. The service builds a machine-managed deploy clone
# ($SERVICE_HOME/repo), so this stub fakes the remote end: clone creates a
# sources-looking tree, fetch is a no-op, and origin/BRANCH resolves to
# $STATE_DIR/remote_sha. State in $STATE_DIR:
#   remote_sha    — sha reported for origin/BRANCH (default aaa1111);
#                   change it between runs to simulate a push
#   clone_layout  — "apps" => clone creates apps/web/build/build_site.py,
#                   anything else => scripts/build_site.py
#   git_auth_fail — exists => ls-remote fails like missing credentials
echo "git $*" >> "$CALLS_LOG"

dir=""
if [ "${1:-}" = "-C" ]; then dir="$2"; shift 2; fi

case "${1:-}" in
  ls-remote)
    if [ -f "$STATE_DIR/git_auth_fail" ]; then
      echo "fatal: could not read Username for 'https://github.com': terminal prompts disabled" >&2
      exit 128
    fi
    printf '%s\trefs/heads/main\n' "$(cat "$STATE_DIR/remote_sha" 2>/dev/null || echo aaa1111)"
    ;;
  remote)
    # git -C <dir> remote get-url origin — real git fails outside a repo
    [ -d "$dir/.git" ] || exit 2
    echo "https://git.test/sources.git"
    ;;
  clone)
    # last argument is the target directory; fake a sources checkout whose
    # build-script layout follows $STATE_DIR/clone_layout
    target=""
    for a in "$@"; do target="$a"; done
    mkdir -p "$target/.git"
    if [ "$(cat "$STATE_DIR/clone_layout" 2>/dev/null)" = "apps" ]; then
      mkdir -p "$target/apps/web/build"
      echo "# build stub" > "$target/apps/web/build/build_site.py"
    else
      mkdir -p "$target/scripts"
      echo "# build stub" > "$target/scripts/build_site.py"
    fi
    ;;
  rev-parse)
    cat "$STATE_DIR/remote_sha" 2>/dev/null || echo aaa1111
    ;;
  merge-base)
    # --is-ancestor <sha> <head>: true only when <sha> is the known ref tip
    [ "$3" = "$(cat "$STATE_DIR/remote_sha" 2>/dev/null || echo aaa1111)" ] && exit 0 || exit 1
    ;;
  fetch|reset|status) ;;
esac
exit 0
