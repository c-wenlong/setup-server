#!/usr/bin/env bash
# uv stub. `uv sync` no-ops; `uv run scripts/build_site.py --out DIR` fakes a
# build by writing the files the tests look for (index.html + d/key.json).
# Mirrors build_site.py's has_jobs check: when data/jobs/jobs.db exists in
# the cwd (the deploy clone; -f follows the deploy.sh symlink), the build
# also emits d/jobs.bin.
echo "uv $*" >> "$CALLS_LOG"

case "$1" in
  sync) ;;
  run)
    out=""
    prev=""
    for a in "$@"; do
      [ "$prev" = "--out" ] && out="$a"
      prev="$a"
    done
    if [ -n "$out" ]; then
      mkdir -p "$out/d"
      echo "stub index" > "$out/index.html"
      echo "stub js" > "$out/app.js"
      echo '{}' > "$out/d/key.json"
      [ -f data/jobs/jobs.db ] && echo "stub jobs" > "$out/d/jobs.bin"
    fi
    ;;
esac
exit 0
