#!/usr/bin/env bash
# tailscale stub. State lives in $STATE_DIR:
#   backend_state     — override BackendState (default Running)
#   operator          — exists => serve allowed without sudo
#   serve_fails_left  — countdown of forced serve failures (approval-link flow)
#   ts_ip             — override the reported v4 address (default 100.77.77.77)
#   no_ts_ip          — `tailscale ip -4` prints nothing and fails
#   serve_status      — text `tailscale serve status` prints (teardown tests);
#                       absent => the mapping this deploy published
#   serve_status_fails — exists => `serve status` fails like a stopped daemon
#
# The reported node is test-host.tailfake.ts.net and the address 100.77.77.77 —
# deliberately NOT this box's kai-home-server / 100.85.87.87. A URL that only
# matched because someone hardcoded the real tailnet name into setup.sh or
# docker-compose.yml would then pass while being wrong on every other machine,
# and on THIS service the tailnet URL is not cosmetic: it is the string that
# has to land in PAPERLESS_URL, which is what CSRF_TRUSTED_ORIGINS is built
# from. A hardcoded hostname is a login that fails for everyone but this box.
echo "tailscale $*" >> "$CALLS_LOG"

# teardown.sh: `serve status` (read once, before any change) and `serve
# --https=N off`. Answered ahead of the operator gate, like the real daemon
# answers status reads for any user.
if [ "$1" = "serve" ] && [ "${2:-}" = "status" ]; then
  if [ -f "$STATE_DIR/serve_status_fails" ]; then
    echo "failed to connect to local tailscaled" >&2
    exit 1
  fi
  if [ -f "$STATE_DIR/serve_status" ]; then
    cat "$STATE_DIR/serve_status"
    exit 0
  fi
fi
case " $* " in *" off "*) [ "$1" = "serve" ] && exit 0 ;; esac

case "$1" in
  status)
    state="Running"
    [ -f "$STATE_DIR/backend_state" ] && state="$(cat "$STATE_DIR/backend_state")"
    cat <<EOF
{
  "BackendState": "$state",
  "Self": {
    "DNSName": "test-host.tailfake.ts.net."
  }
}
EOF
    ;;
  ip)
    if [ -f "$STATE_DIR/no_ts_ip" ]; then
      echo "no current Tailscale address" >&2
      exit 1
    fi
    case "$2" in
      -6) echo "fd7a:115c:a1e0::1111:2222" ;;
      *)  cat "$STATE_DIR/ts_ip" 2>/dev/null || echo "100.77.77.77" ;;
    esac
    ;;
  serve)
    if [ -f "$STATE_DIR/serve_fails_left" ]; then
      left="$(cat "$STATE_DIR/serve_fails_left")"
      if [ "$left" -gt 0 ]; then
        echo $((left - 1)) > "$STATE_DIR/serve_fails_left"
        echo "Serve is not enabled on your tailnet." >&2
        echo "To enable, visit: https://login.tailscale.com/f/serve?node=FAKE" >&2
        exit 1
      fi
    fi
    # Operator gating is a Linux tailscaled concept; macOS has no operator.
    if [ "$(uname -s)" != "Darwin" ] && [ ! -f "$STATE_DIR/operator" ]; then
      echo "sending serve config: Access denied: serve config denied" >&2
      exit 1
    fi
    case "$2" in
      status)
        # Only what this deploy publishes. Nothing else on the node, because a
        # stub that echoed the real `serve status` would let an assertion pass
        # on some other service's mapping.
        port="$(cat "$STATE_DIR/serve_port" 2>/dev/null || echo 8095)"
        local_port="$(cat "$STATE_DIR/serve_local_port" 2>/dev/null || echo 8095)"
        printf 'https://test-host.tailfake.ts.net:%s (tailnet only)\n' "$port"
        printf '|-- / proxy http://127.0.0.1:%s\n' "$local_port"
        ;;
      *)
        # Record what was actually published so the harness can assert the
        # mapping, and so `serve status` above reports it back.
        for a in "$@"; do
          case "$a" in
            --https=*) printf '%s' "${a#--https=}" > "$STATE_DIR/serve_port" ;;
            http://127.0.0.1:*) printf '%s' "${a##*:}" > "$STATE_DIR/serve_local_port" ;;
          esac
        done
        echo "Serve started and running in the background."
        ;;
    esac
    ;;
  set)
    case "$2" in
      --operator=*) touch "$STATE_DIR/operator" ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
