#!/usr/bin/env bash
# systemctl stub: logs every call to $CALLS_LOG (the teardown tests assert
# which units were disabled/stopped) and succeeds, except for the gallery
# app unit deploy.sh probes. State in $STATE_DIR:
#   web_unit          — exists => `systemctl --user cat designs-web` succeeds
#                       (the unit is installed); absent => it fails
#   web_restart_fail  — exists => `restart designs-web` fails
echo "systemctl $*" >> "$CALLS_LOG"
args=" $* "
case "$args" in
  *" cat designs-web "*)
    [ -f "$STATE_DIR/web_unit" ] || { echo "No files found for designs-web.service." >&2; exit 1; }
    echo "# designs-web.service (stub)"
    ;;
  *" restart designs-web "*)
    [ -f "$STATE_DIR/web_restart_fail" ] && { echo "Job for designs-web.service failed." >&2; exit 1; }
    ;;
esac
exit 0
