#!/usr/bin/env bash
# uv stub. `uv venv ... .venv` drops a fake `python` binary into the venv so
# deploy.sh finds `.venv/bin/python` afterwards; `uv pip install` no-ops.
echo "uv $*" >> "$CALLS_LOG"

case "$1" in
  venv)
    dir=".venv"
    for a in "$@"; do
      case "$a" in .venv|*/.venv) dir="$a" ;; esac
    done
    mkdir -p "$dir/bin"
    cat > "$dir/bin/python" <<'Z'
#!/usr/bin/env bash
# venv python stub: `tools/site.py` fakes the docs site output the tests look for.
echo "python $*" >> "$CALLS_LOG"
if [ "$1" = "tools/site.py" ]; then
  mkdir -p site/gallery
  echo "stub index" > site/index.html
  echo "stub gallery" > site/gallery/index.html
  # Real generators can leave mkstemp-mode (0600) files and 0700 dirs in
  # site/ — the release must normalise them or nginx answers 403.
  echo "stub data" > site/data0600.json && chmod 600 site/data0600.json
  mkdir -p site/closed-dir && chmod 700 site/closed-dir
fi
exit 0
Z
    chmod +x "$dir/bin/python"
    ;;
  pip|sync|run) ;;
esac
exit 0
