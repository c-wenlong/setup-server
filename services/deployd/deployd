#!/usr/bin/env python3
#
# deployd — one poll cycle over every services/*/app.json "deploy" block in
# the setup-server checkout: refresh the checkout, resolve each watched git
# ref, and run that service's deploy command when the remote moved.
#
# This is the tailnet-only answer to GitHub webhooks: nothing can reach this
# box inbound, so a poller pulls refs outbound instead. One oneshot per tick
# (systemd user timer / launchd on a POLL_SECONDS cadence), never a resident
# daemon — config changes land by re-reading .env and the checkout each run.
#
# Where things live:
#   config   $SETUP_REPO/services/deployd/.env   (SETUP_REPO, RETRY_SECONDS,
#                                                DEPLOY_TIMEOUT, PATH_PREFIX;
#                                                POLL_SECONDS is read by
#                                                setup.sh when it writes the
#                                                timer, not here)
#   state    $SERVICE_HOME/state/<key>.sha       last deployed remote sha
#            $SERVICE_HOME/state/<key>.fail      {"sha":..,"at":..} backoff
#            $SERVICE_HOME/state/<key>.log       tail of the last cmd output
#            $SERVICE_HOME/state/pollers.json    launcher-written overrides:
#                                                {"pollers": {key: {repo,ref,
#                                                 cmd} | {"enabled": false}}}
#            $SERVICE_HOME/state/*.pending       a checkout-reaction that
#                                                failed (self-update or
#                                                launcher restart), retried
#                                                every tick until it works
#            $SERVICE_HOME/state/launcher-code.seen
#                                                newest app/web/ code mtime
#                                                already restarted for — the
#                                                freshness baseline that lets
#                                                a checkout moved outside
#                                                deployd's own pull still
#                                                restart the launcher
#   lock     $SERVICE_HOME/.poll.lock            mkdir lock, stale at 60 min
#
# Trust model: a "deploy" block runs its `cmd` as this user, so it carries
# exactly the trust of pushing to the setup-server repo — the same trust as
# editing a service's setup.sh and running it.
#
# Usage:
#   deployd                  # one poll cycle (what the timer runs)
#   deployd --force <key>    # run one service's deploy cmd now, state or not
#   deployd --status         # table of entries, recorded shas, failures
#
# Exit status: 0 on a clean tick (locked-out counts as clean), 1 if any
# deploy or lookup failed, so `systemctl --user status deployd` shows it.

import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time

ENV_BAKED = "__ENV_FILE__"  # setup.sh rewrites this to the absolute .env path
LOCK_STALE_SECONDS = 3600
RETRY_SECONDS = 900         # re-try a failed deploy of the same sha
DEPLOY_TIMEOUT = 1800       # a single deploy cmd may run this long
GIT_TIMEOUT = 60


def log(msg):
    print("deployd: %s" % msg, flush=True)


def warn(msg):
    print("deployd: warning: %s" % msg, file=sys.stderr, flush=True)


def env_path():
    override = os.environ.get("DEPLOYD_ENV")
    if override:
        return override
    if "/" in ENV_BAKED:
        return ENV_BAKED
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), ".env")


def load_env(path):
    """Read KEY=value lines. setup.sh writes values %q-escaped (the repo's
    shell convention); shlex splits those back to the real value."""
    out = {}
    if not os.path.isfile(path):
        return out
    for line in open(path):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, raw = line.partition("=")
        try:
            parts = shlex.split(raw)
            out[key.strip()] = parts[0] if parts else ""
        except ValueError:
            out[key.strip()] = raw
    return out


def run(argv, cwd=None, env=None, timeout=GIT_TIMEOUT, group_kill=False):
    """Run argv, return (rc, combined output). Never raises on nonzero.
    group_kill puts the child in its own process group so a timeout can
    killpg() the whole tree — a service setup.sh spawns uv/git/docker
    grandchildren that a plain p.kill() would orphan mid-write."""
    merged = dict(os.environ)
    if env:
        merged.update(env)
    try:
        p = subprocess.Popen(argv, cwd=cwd, env=merged,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             universal_newlines=True,
                             start_new_session=group_kill)
    except OSError as e:
        return 127, str(e)
    try:
        out, _ = p.communicate(timeout=timeout)
        return p.returncode, out or ""
    except subprocess.TimeoutExpired:
        if group_kill:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
        else:
            p.kill()
        try:
            out, _ = p.communicate()
        except Exception:
            out = ""
        suffix = "timed out after %ss" % timeout
        return 124, (out + "\n" + suffix) if out else suffix


def git(repo_dir, *args):
    return run(["git", "-C", repo_dir] + list(args))


def resolve_ref(repo_url, ref):
    """Remote sha for a branch or tag name, or None on lookup failure.
    A 40-hex ref is already a sha and needs no lookup."""
    if len(ref) == 40 and all(c in "0123456789abcdef" for c in ref.lower()):
        return ref
    patterns = [ref] if ref.startswith("refs/") else [
        "refs/heads/%s" % ref, "refs/tags/%s^{}" % ref, "refs/tags/%s" % ref]
    rc, out = run(["git", "ls-remote", repo_url] + patterns,
                  env={"GIT_TERMINAL_PROMPT": "0"})
    if rc != 0:
        warn("ls-remote %s failed: %s" % (repo_url, out.strip().splitlines()[-1]
                                          if out.strip() else "rc=%s" % rc))
        return None
    found = {}
    for line in out.splitlines():
        sha, _, name = line.strip().partition("\t")
        if name:
            found[name] = sha
    for pattern in patterns:
        if pattern in found:
            return found[pattern]
    warn("no ref %r at %s" % (ref, repo_url))
    return None


POLLER_KEY_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")


def _valid_deploy(repo, cmd):
    return isinstance(repo, str) and bool(repo) \
        and isinstance(cmd, str) and bool(cmd)


def load_overrides(state_dir):
    """state/pollers.json — the launcher UI's edit layer, merged over the
    manifest scan so the UI never writes inside the (ff-pulled) checkout.
    Values are either a definition {repo, ref?, cmd} that upserts the
    entry, or a tombstone {"enabled": false} that suppresses it. A
    malformed file or entry warns and is ignored — a bad write must not
    wedge the poll."""
    path = os.path.join(state_dir, "pollers.json")
    if not os.path.isfile(path):
        return {}
    try:
        with open(path) as fh:
            data = json.load(fh)
    except (OSError, ValueError) as e:
        warn("cannot parse %s: %s — ignoring overrides" % (path, e))
        return {}
    pollers = data.get("pollers") if isinstance(data, dict) else None
    if not isinstance(pollers, dict):
        warn("%s: expected {\"pollers\": {...}} — ignoring overrides" % path)
        return {}
    out = {}
    for key, spec in pollers.items():
        # Keys name state files; a key with "/" or ".." would walk paths.
        if not isinstance(key, str) or not POLLER_KEY_RE.match(key) \
                or not isinstance(spec, dict):
            warn("%s: bad poller entry %r — skipping" % (path, key))
            continue
        out[key] = spec
    return out


def scan_entries(setup_repo, state_dir=None):
    """Effective poller list -> ([{key, repo, ref, cmd, source}], suppressed).

    The manifest scan is the base layer: every services/*/app.json 'deploy'
    block needs repo and cmd (ref defaults to main); a manifest
    "enabled": false is a hard off — recorded in suppressed and never
    overridden. When state_dir is given, state/pollers.json merges on top:
    definitions upsert (source 'override' over a manifest, 'custom' for a
    new key) and tombstones suppress a manifest entry. Anything malformed
    warns and is skipped so one bad file cannot break the cycle."""
    entries = []
    suppressed = []
    seen = {}
    hard_off = set()
    svc_root = os.path.join(setup_repo, "services")
    try:
        names = sorted(os.listdir(svc_root))
    except OSError:
        warn("no services dir at %s" % svc_root)
        names = []
    for name in names:
        manifest = os.path.join(svc_root, name, "app.json")
        if not os.path.isfile(manifest):
            continue
        try:
            data = json.load(open(manifest))
        except (OSError, ValueError) as e:
            warn("cannot parse %s: %s" % (manifest, e))
            continue
        deploy = data.get("deploy") if isinstance(data, dict) else None
        if deploy is None:
            continue
        if not isinstance(deploy, dict):
            warn("%s: deploy must be an object" % manifest)
            continue
        key = data.get("key")
        key = key if isinstance(key, str) and key else name
        if deploy.get("enabled") is False:
            hard_off.add(key)
            suppressed.append({
                "key": key, "by": "manifest",
                "repo": deploy.get("repo"),
                "ref": deploy.get("ref") or "main",
                "cmd": deploy.get("cmd"),
            })
            continue
        repo, cmd = deploy.get("repo"), deploy.get("cmd")
        ref = deploy.get("ref") or "main"
        if not _valid_deploy(repo, cmd):
            warn("%s: deploy needs string \"repo\" and \"cmd\"" % manifest)
            continue
        if not isinstance(ref, str):
            warn("%s: deploy \"ref\" must be a string" % manifest)
            continue
        seen[key] = len(entries)
        entries.append({"key": key, "repo": repo, "ref": ref, "cmd": cmd,
                        "source": "manifest"})
    if state_dir:
        for key, spec in load_overrides(state_dir).items():
            if key in hard_off:
                warn("state/pollers.json: %r is disabled in app.json — "
                     "manifest wins" % key)
                continue
            if spec.get("enabled") is False:
                if key in seen:
                    old = entries.pop(seen[key])
                    suppressed.append({"key": key, "by": "override",
                                       "repo": old["repo"],
                                       "ref": old["ref"], "cmd": old["cmd"]})
                    seen = {e["key"]: i for i, e in enumerate(entries)}
                continue
            repo, cmd = spec.get("repo"), spec.get("cmd")
            ref = spec.get("ref") or "main"
            if not _valid_deploy(repo, cmd):
                warn("state/pollers.json: %r needs string \"repo\" and "
                     "\"cmd\"" % key)
                continue
            if not isinstance(ref, str):
                warn("state/pollers.json: %r \"ref\" must be a string" % key)
                continue
            entry = {"key": key, "repo": repo, "ref": ref, "cmd": cmd,
                     "source": "override" if key in seen else "custom"}
            if key in seen:
                entries[seen[key]] = entry
            else:
                seen[key] = len(entries)
                entries.append(entry)
    return entries, suppressed


def state_paths(state_dir, key):
    safe = "".join(c if c.isalnum() or c in "-_." else "_" for c in key)
    return (os.path.join(state_dir, safe + ".sha"),
            os.path.join(state_dir, safe + ".fail"),
            os.path.join(state_dir, safe + ".log"))


def disabled_path(state_dir, key):
    """teardown.sh drops state/<key>.disabled so a removed service stays
    removed; a manual services/<name>/setup.sh clears it to opt back in."""
    safe = "".join(c if c.isalnum() or c in "-_." else "_" for c in key)
    return os.path.join(state_dir, safe + ".disabled")


def read_sha(path):
    try:
        return open(path).read().strip() or None
    except OSError:
        return None


def backoff_seconds_left(fail_file, sha, retry_seconds):
    """Seconds until a retry of this sha is allowed, or 0."""
    try:
        rec = json.load(open(fail_file))
    except (OSError, ValueError):
        return 0
    if not isinstance(rec, dict) or rec.get("sha") != sha:
        return 0
    left = retry_seconds - (time.time() - rec.get("at", 0))
    return max(0, int(left))


def record_fail(fail_file, sha, rc):
    try:
        with open(fail_file, "w") as fh:
            json.dump({"sha": sha, "at": time.time(), "rc": rc}, fh)
    except OSError as e:
        warn("cannot write %s: %s" % (fail_file, e))


def deploy(entry, sha, setup_repo, state_dir, timeout):
    """Run one entry's cmd. Returns (ok, rc). Output tail -> state/<key>.log."""
    sha_file, fail_file, log_file = state_paths(state_dir, entry["key"])
    env = {
        "DEPLOY_NAME": entry["key"],
        "DEPLOY_REPO": entry["repo"],
        "DEPLOY_REF": entry["ref"],
        "DEPLOY_SHA": sha,
    }
    log("%s: %s -> %s" % (entry["key"], entry["ref"], sha[:12]))
    rc, out = run(["bash", "-c", entry["cmd"]], cwd=setup_repo, env=env,
                  timeout=timeout, group_kill=True)
    if out:
        # the deploy cmd's own output is the useful part of the service log
        sys.stdout.write(out if out.endswith("\n") else out + "\n")
    tail = "\n".join(out.splitlines()[-80:])
    try:
        with open(log_file, "w") as fh:
            fh.write(out if len(out) < 200000 else out[-200000:])
    except OSError as e:
        warn("cannot write %s: %s" % (log_file, e))
    if rc == 0:
        if sha != "forced":  # a --force run while the remote was unreachable
            try:
                with open(sha_file, "w") as fh:
                    fh.write(sha + "\n")
            except OSError as e:
                warn("cannot write %s: %s" % (sha_file, e))
        try:
            os.remove(fail_file)
        except OSError:
            pass
        log("%s: deployed %s" % (entry["key"], sha[:12]))
        return True, 0
    warn("%s: deploy failed (rc=%s); tail:\n%s" % (entry["key"], rc, tail))
    record_fail(fail_file, sha, rc)
    return False, rc


def write_marker(path, sha):
    try:
        with open(path, "w") as fh:
            fh.write(sha + "\n")
    except OSError as e:
        warn("cannot write %s: %s" % (path, e))


def launcher_code_path(path):
    """A pull-diff path the running launcher cannot pick up live. static/
    is served from disk per request and services.json re-read on mtime, so
    the restart trigger is everything else under app/web/ — server.py
    today, whatever it grows later."""
    return path.startswith("app/web/") and not (
        path.startswith("app/web/static/")
        or path == "app/web/services.json")


def launcher_code_mtime(setup_repo):
    """Newest mtime across the files launcher_code_path() names — the code
    set a restart exists to reload. 0 when the checkout has no app/web/ at
    all (a fixture, a tools-only clone)."""
    root = os.path.join(setup_repo, "app", "web")
    newest = 0.0
    for base, _dirs, files in os.walk(root):
        for name in files:
            rel = os.path.relpath(os.path.join(base, name), setup_repo)
            if not launcher_code_path(rel):
                continue
            try:
                newest = max(newest, os.path.getmtime(
                    os.path.join(base, name)))
            except OSError:
                pass
    return newest


def launcher_seen_path(state_dir):
    return os.path.join(state_dir, "launcher-code.seen")


def mark_launcher_stale(setup_repo, state_dir):
    """Freshness baseline for the launcher restart. The pull diff above only
    sees moves deployd's own `git pull` made — a manual pull, a hand edit on
    the box, or any other route the checkout takes to move still leaves the
    old process running. launcher-code.seen records the newest code mtime
    already actioned; anything newer gets the same pending marker and falls
    into the normal restart path. First tick has no baseline, so it marks
    once; the restart (or a not-running launcher) writes the baseline, so it
    fires once per change instead of every tick."""
    newest = launcher_code_mtime(setup_repo)
    if newest <= 0:
        return
    try:
        with open(launcher_seen_path(state_dir)) as fh:
            seen = float(fh.read().strip() or 0)
    except (OSError, ValueError):
        seen = 0.0
    if newest <= seen:
        return
    write_marker(os.path.join(state_dir, "launcher-restart.pending"),
                 "mtime:%r" % newest)


def record_launcher_baseline(state_dir, newest):
    """Stamp the code mtime the launcher state now satisfies. The caller
    passes the mtime captured *before* its restart/probe so a file changed
    mid-restart still reads newer next tick instead of being stamped as
    already loaded. Full precision: float mtimes exist on every modern fs,
    and a truncated baseline would re-mark on every later tick."""
    write_marker(launcher_seen_path(state_dir), repr(newest))


LAUNCHER_UNIT = "launcher.service"      # app/web/setup.sh's systemd unit,
LAUNCHER_LABEL = "com.launcher.server"  # launchd label


def _launcher_running(env):
    """True = a launcher process is up (running stale code). False =
    definitely not — stopped, disabled, or never installed, so its next
    start loads the new code anyway. None = the probe could not answer; an
    unanswered probe must never be read as 'not running'."""
    if sys.platform == "darwin":
        domain = "gui/%d/%s" % (os.getuid(), LAUNCHER_LABEL)
        rc, _ = run(["launchctl", "print", domain], env=env)
        if rc == 0:
            return True
        plist = os.path.expanduser(
            "~/Library/LaunchAgents/%s.plist" % LAUNCHER_LABEL)
        if not os.path.isfile(plist):
            return False
        # Plist on disk but the job is not loaded: disabled deliberately or
        # bootout'd — either way nothing is running. Only a failed
        # print-disabled leaves the question unanswered.
        rc, _ = run(["launchctl", "print-disabled",
                     "gui/%d" % os.getuid()], env=env)
        return None if rc != 0 else False
    rc, out = run(["systemctl", "--user", "show", LAUNCHER_UNIT], env=env)
    if rc != 0:
        return None
    props = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    # failed counts as running: restart is also what revives a dead unit.
    return props.get("ActiveState") in (
        "active", "activating", "reloading", "failed", "deactivating")


def restart_launcher(pending, setup_repo, state_dir):
    """Re-exec the launcher so it loads the new server.py — it runs
    straight from the checkout, and the running process holds the old code
    forever otherwise. A launcher that is stopped or absent has nothing
    stale to fix: the marker is dropped (its next start loads new code
    anyway). `restart` signals the unit's whole cgroup, so a launcher job
    in flight dies with it — tolerated because every deploy cmd is built
    to re-run. The marker stays on failure or an unanswered probe and
    retries next tick. Every path that leaves nothing stale stamps the
    launcher-code.seen baseline, so an mtime-triggered mark fires once per
    change instead of every tick."""
    if sys.platform == "darwin":
        restart = ["launchctl", "kickstart", "-k",
                   "gui/%d/%s" % (os.getuid(), LAUNCHER_LABEL)]
        env = None
    else:
        # A user unit inherits the manager env, but a hand-run poller can
        # lack the bus address.
        env = {"XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR")
               or "/run/user/%d" % os.getuid()}
        restart = ["systemctl", "--user", "restart", LAUNCHER_UNIT]
    # Baseline is what the code tree looked like *before* the restart —
    # a pull or edit landing while the unit cycles reads newer than this
    # next tick, so it can never be stamped as already loaded.
    baseline = launcher_code_mtime(setup_repo)
    running = _launcher_running(env)
    if running is False:
        log("app/web/ changed but no launcher is running — nothing to "
            "restart")
        try:
            os.remove(pending)
        except OSError:
            pass
        record_launcher_baseline(state_dir, baseline)
        return
    if running is None:
        warn("cannot tell whether the launcher is running — keeping the "
             "restart pending")
        return
    log("app/web/ changed — restarting the launcher")
    rc, out = run(restart, env=env)
    if rc == 0:
        try:
            os.remove(pending)
        except OSError:
            pass
        record_launcher_baseline(state_dir, baseline)
        log("launcher restarted")
    else:
        warn("launcher restart failed (rc=%s); retrying next tick: %s"
             % (rc, out.strip().splitlines()[-1]
                if out.strip() else "rc only"))


def refresh_checkout(setup_repo, state_dir):
    """ff-only pull of the setup-server checkout; config lives in it, so a
    stale checkout means stale config. Two consumers run code the pull can
    replace: services/deployd/ re-runs its setup.sh (self-update — this
    tick keeps running the old build), and app/web/ restarts the launcher
    unit, which execs server.py from this tree. A pending marker makes a
    failed reaction retry next tick — the checkout has already moved by
    then, so sha comparison alone would never fire again. Pull failures
    warn; pending retries still run."""
    pending = os.path.join(state_dir, "self-update.pending")
    launcher_pending = os.path.join(state_dir, "launcher-restart.pending")
    rc, old = git(setup_repo, "rev-parse", "HEAD")
    if rc != 0:
        warn("%s is not a git checkout — scanning it as-is" % setup_repo)
        return
    old = old.strip()
    rc, out = git(setup_repo, "pull", "--ff-only", "--quiet")
    if rc == 0:
        rc, new = git(setup_repo, "rev-parse", "HEAD")
        new = new.strip() if rc == 0 else old
        if new != old:
            log("checkout moved %s -> %s" % (old[:8], new[:8]))
            rc, diff = git(setup_repo, "diff", "--name-only", old, new)
            if rc == 0:
                changed = diff.splitlines()
                if any(p.startswith("services/deployd/")
                       for p in changed):
                    write_marker(pending, new)
                if any(launcher_code_path(p) for p in changed):
                    write_marker(launcher_pending, new)
                if "app/web/setup.sh" in changed:
                    log("app/web/setup.sh changed — re-run it by hand to "
                        "pick up unit/plist changes")
    else:
        warn("setup-server pull did not apply (dirty tree, offline, or "
             "diverged): %s" % out.strip().splitlines()[-1]
             if out.strip() else "setup-server pull did not apply")
    if os.path.exists(pending):
        setup = os.path.join(setup_repo, "services", "deployd", "setup.sh")
        log("applying deployd self-update")
        rc, out = run(["bash", setup], cwd=setup_repo, timeout=DEPLOY_TIMEOUT,
                      group_kill=True, env={"DEPLOYD_SELF_UPDATE": "1"})
        if rc == 0:
            try:
                os.remove(pending)
            except OSError:
                pass
        else:
            warn("deployd self-update failed (rc=%s); retrying next tick:\n%s"
                 % (rc, "\n".join(out.splitlines()[-40:])))
    # A pull deployd did not make — a manual `git pull`, a hand edit, a
    # checkout repaired some other way — is invisible to the diff above but
    # leaves the same stale process. Baseline freshness catches it.
    mark_launcher_stale(setup_repo, state_dir)
    if os.path.exists(launcher_pending):
        restart_launcher(launcher_pending, setup_repo, state_dir)


def acquire_lock(service_home):
    """mkdir the poll lock, reclaiming it when stale. Lock path or None."""
    lock = os.path.join(service_home, ".poll.lock")
    if os.path.isdir(lock):
        try:
            stale = time.time() - os.path.getmtime(lock) > LOCK_STALE_SECONDS
        except OSError:
            stale = False
        if stale:
            log("removing a stale poll lock (>60 min old)")
            try:
                os.rmdir(lock)
            except OSError:
                pass
    try:
        os.mkdir(lock)
        return lock
    except OSError:
        return None


def tick(env):
    setup_repo = env.get("SETUP_REPO")
    if not setup_repo:
        warn("SETUP_REPO is not set in %s" % env_path())
        return 1
    service_home = env.get("SERVICE_HOME") or os.path.expanduser(
        "~/services/deployd")
    state_dir = os.path.join(service_home, "state")
    retry = int(env.get("RETRY_SECONDS") or RETRY_SECONDS)
    timeout = int(env.get("DEPLOY_TIMEOUT") or DEPLOY_TIMEOUT)
    if env.get("PATH_PREFIX"):
        os.environ["PATH"] = env["PATH_PREFIX"] + ":" + os.environ["PATH"]
    os.environ.setdefault("GIT_TERMINAL_PROMPT", "0")
    try:
        os.makedirs(state_dir, exist_ok=True)
    except OSError as e:
        warn("cannot create %s: %s" % (state_dir, e))
        return 1

    lock = acquire_lock(service_home)
    if not lock:
        log("another poll is running — skipping this tick")
        return 0
    try:
        refresh_checkout(setup_repo, state_dir)
        entries, _ = scan_entries(setup_repo, state_dir)
        if not entries:
            log("no deploy entries in %s/services/*/app.json" % setup_repo)
        failures = 0
        for entry in entries:
            if os.path.exists(disabled_path(state_dir, entry["key"])):
                log("%s: disabled (state/%s.disabled) — skipping"
                    % (entry["key"], entry["key"]))
                continue
            sha = resolve_ref(entry["repo"], entry["ref"])
            if not sha:
                failures += 1
                continue
            sha_file, fail_file, _ = state_paths(state_dir, entry["key"])
            if read_sha(sha_file) == sha:
                continue
            left = backoff_seconds_left(fail_file, sha, retry)
            if left:
                log("%s: deploy of %s failed recently — retrying in %ss"
                    % (entry["key"], sha[:12], left))
                continue
            # Re-check just before running: a teardown during the ref lookup
            # would otherwise see the flag cleared by the cmd's own
            # setup.sh, and a launcher "Remove" mid-lookup only writes
            # pollers.json — rescan so this tick cannot fire a cmd the UI
            # believes is gone.
            if os.path.exists(disabled_path(state_dir, entry["key"])):
                log("%s: disabled mid-tick (state/%s.disabled) — skipping"
                    % (entry["key"], entry["key"]))
                continue
            if not any(e["key"] == entry["key"]
                       for e in scan_entries(setup_repo, state_dir)[0]):
                log("%s: removed mid-tick — skipping" % entry["key"])
                continue
            ok, _ = deploy(entry, sha, setup_repo, state_dir, timeout)
            if not ok:
                failures += 1
        if failures:
            warn("%s entr%s failed this tick"
                 % (failures, "y" if failures == 1 else "ies"))
        return 1 if failures else 0
    finally:
        try:
            os.rmdir(lock)
        except OSError:
            pass


def force(key, env):
    setup_repo = env.get("SETUP_REPO")
    if not setup_repo:
        warn("SETUP_REPO is not set in %s" % env_path())
        return 1
    service_home = env.get("SERVICE_HOME") or os.path.expanduser(
        "~/services/deployd")
    state_dir = os.path.join(service_home, "state")
    if env.get("PATH_PREFIX"):
        os.environ["PATH"] = env["PATH_PREFIX"] + ":" + os.environ["PATH"]
    try:
        os.makedirs(state_dir, exist_ok=True)
    except OSError as e:
        warn("cannot create %s: %s" % (state_dir, e))
        return 1
    # same lock as a tick: --force may jump the sha/backoff, but never runs
    # two deploys of the same service at once
    lock = acquire_lock(service_home)
    if not lock:
        warn("a poll is running — retry --force when it finishes")
        return 1
    try:
        for entry in scan_entries(setup_repo, state_dir)[0]:
            if entry["key"] == key:
                if os.path.exists(disabled_path(state_dir, key)):
                    warn("%s: disabled (state/%s.disabled) — resume it in "
                         "the launcher, run its setup.sh to re-enable, or "
                         "remove the flag" % (key, key))
                    return 1
                sha = resolve_ref(entry["repo"], entry["ref"]) or "forced"
                ok, rc = deploy(entry, sha, setup_repo, state_dir,
                                int(env.get("DEPLOY_TIMEOUT") or DEPLOY_TIMEOUT))
                return 0 if ok else rc or 1
        warn("no deploy entry named %r" % key)
        return 1
    finally:
        try:
            os.rmdir(lock)
        except OSError:
            pass


def status(env):
    setup_repo = env.get("SETUP_REPO")
    if not setup_repo:
        warn("SETUP_REPO is not set in %s" % env_path())
        return 1
    service_home = env.get("SERVICE_HOME") or os.path.expanduser(
        "~/services/deployd")
    state_dir = os.path.join(service_home, "state")
    entries, suppressed = scan_entries(setup_repo, state_dir)
    if not entries and not suppressed:
        print("no deploy entries in %s/services/*/app.json" % setup_repo)
        return 0
    print("%-18s %-8s %-12s %s" % ("SERVICE", "REF", "DEPLOYED", "STATE"))
    for e in entries:
        sha_file, fail_file, _ = state_paths(state_dir, e["key"])
        seen = read_sha(sha_file)
        notes = []
        if e["source"] != "manifest":
            notes.append("%s via state/pollers.json" % e["source"])
        if os.path.exists(disabled_path(state_dir, e["key"])):
            notes.append("disabled")
        try:
            rec = json.load(open(fail_file))
            notes.append("last attempt failed (rc=%s) %ss ago" % (
                rec.get("rc"), int(time.time() - rec.get("at", 0))))
        except (OSError, ValueError):
            pass
        note = "; ".join(notes)
        print("%-18s %-8s %-12s %s"
              % (e["key"], e["ref"], (seen or "never")[:12], note))
    for s in suppressed:
        print("%-18s %-8s %-12s %s" % (
            s["key"], s["ref"], "-",
            "disabled in app.json" if s["by"] == "manifest"
            else "removed via launcher"))
    return 0


def main(argv):
    env = load_env(env_path())
    args = argv[1:]
    if args == ["--status"]:
        return status(env)
    if len(args) == 2 and args[0] == "--force":
        return force(args[1], env)
    if not args:
        if not env:
            warn("no config at %s (run services/deployd/setup.sh)"
                 % env_path())
            return 1
        return tick(env)
    print("usage: deployd [--status | --force <key>]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
