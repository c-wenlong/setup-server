#!/usr/bin/env bash
# git stub. The service builds the existing working clone (SOURCE_REPO), so
# this stub only answers the read/pull/lfs commands setup.sh and deploy.sh
# run. State in $STATE_DIR:
#   local_sha   — sha reported by `rev-parse HEAD` (default aaa1111);
#                 change it between runs to simulate a new commit
#   pull_fail   — exists => `pull --ff-only` fails (dirty/diverged clone)
#   lfs_broken  — exists => `lfs pull` succeeds but fixes no pointer files
echo "git $*" >> "$CALLS_LOG"

REPO_ARG="."
if [ "${1:-}" = "-C" ]; then REPO_ARG="$2"; shift 2; fi

case "${1:-}" in
  rev-parse)
    case "${2:-}" in
      --git-dir) echo ".git" ;;   # like real rev-parse inside a worktree
      *) cat "$STATE_DIR/local_sha" 2>/dev/null || echo aaa1111 ;;
    esac
    ;;
  pull)
    if [ -f "$STATE_DIR/pull_fail" ]; then
      echo "error: cannot pull with rebase: you have unstaged changes" >&2
      exit 1
    fi
    ;;
  lfs)
    case "${2:-}" in
      version) echo "git-lfs/3.7.1 (stub)" ;;
      pull)
        # Materialise pointers: real `lfs pull` rewrites the ~130-byte ASCII
        # pointer with the object. A file made of binary PNG magic is no
        # longer a pointer, which is all the preflight checks.
        [ -f "$STATE_DIR/lfs_broken" ] && exit 0
        find "$REPO_ARG/systems" -type f -size -400c 2>/dev/null | while IFS= read -r f; do
          if head -c 9 "$f" 2>/dev/null | grep -q 'version h'; then
            printf '\211PNG\r\n\032\n' > "$f"
          fi
        done
        ;;
    esac
    ;;
  fetch|status) ;;
esac
exit 0
