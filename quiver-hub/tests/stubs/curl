#!/usr/bin/env bash
# curl stub: the hub's /v1/status answers {"ok": true} unless $STATE_DIR/hub_down
# exists. Every other URL succeeds silently.
echo "curl $*" >> "$CALLS_LOG"

url=""
for a in "$@"; do
  case "$a" in http*) url="$a" ;; esac
done

case "$url" in
  */v1/status)
    [ -f "$STATE_DIR/hub_down" ] && exit 7
    echo '{"ok": true, "v": 1, "version": "1.0.0", "machine": {"id": "fake", "name": "test-host"}, "uptime_s": 1}'
    ;;
  *)
    exit 0
    ;;
esac
