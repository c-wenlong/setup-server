#!/usr/bin/env bash
# lsof stub: the macOS fallback for `ss`. Same state, same shapes — the repo
# forbids `ss` without an lsof fallback, so both paths have to be testable.
echo "lsof $*" >> "$CALLS_LOG"

port="$(printf '%s' "$*" | sed -n 's/.*-iTCP:\([0-9]*\).*/\1/p')"
[ -n "$port" ] || port=8097

echo "COMMAND   PID    USER   FD   TYPE DEVICE SIZE/OFF NODE NAME"

if [ "$port" = "8098" ]; then
  echo "python3 1781019 kaichen    3u  IPv4 000000      0t0  TCP 127.0.0.1:8098 (LISTEN)"
  exit 0
fi
if [ -f "$STATE_DIR/port_busy" ]; then
  echo "nginx        1 kaichen    6u  IPv4 000000      0t0  TCP 127.0.0.1:$port (LISTEN)"
  exit 0
fi
[ -f "$STATE_DIR/compose_up" ] || exit 0
if [ -f "$STATE_DIR/wildcard_bind" ]; then
  echo "docker-pr    1 root       4u  IPv4 000000      0t0  TCP 0.0.0.0:$port (LISTEN)"
  exit 0
fi
echo "docker-pr    1 root       4u  IPv4 000000      0t0  TCP 127.0.0.1:$port (LISTEN)"
echo "tailscaled   2 root       9u  IPv4 000000      0t0  TCP 100.77.77.77:$port (LISTEN)"
exit 0
