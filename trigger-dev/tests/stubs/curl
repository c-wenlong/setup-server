#!/usr/bin/env bash
# curl stub — fakes the Trigger.dev HTTP surface. State in $STATE_DIR:
#   health_fails_left  — countdown of 503s from /healthcheck (slow first boot)
echo "curl $*" >> "$CALLS_LOG"

method="GET"; out=""; url=""; want_code=0; failonerr=0
while [ $# -gt 0 ]; do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    -c|-b|-H|--max-time|--connect-timeout|--data-urlencode|-d) shift 2 ;;
    -w) [ "$2" = '%{http_code}' ] && want_code=1; shift 2 ;;
    -[a-zA-Z]*) case "$1" in *f*) failonerr=1 ;; esac; shift ;;
    --*) shift ;;
    *) url="$1"; shift ;;
  esac
done

emit() {
  if [ -n "$out" ]; then
    printf '%s' "$2" > "$out"
  elif [ "$want_code" != "1" ]; then
    printf '%s' "$2"
  fi
  [ "$want_code" = "1" ] && printf '%s' "$1"
  if [ "$failonerr" = "1" ] && [ "$1" -ge 400 ]; then
    echo "curl: (22) The requested URL returned error: $1" >&2
    exit 22
  fi
  exit 0
}

case "$url" in
  */healthcheck)
    if [ -f "$STATE_DIR/health_fails_left" ]; then
      left="$(cat "$STATE_DIR/health_fails_left")"
      if [ "$left" -gt 0 ]; then
        echo $((left - 1)) > "$STATE_DIR/health_fails_left"
        emit 503 'unhealthy'
      fi
    fi
    emit 200 'ok'
    ;;
  */login/magic)
    echo "$method $url" >> "$STATE_DIR/magic_posts"
    emit 302 'redirect'
    ;;
  */login)
    emit 200 '<html>login</html>'
    ;;
  *)
    emit 200 'ok'
    ;;
esac
