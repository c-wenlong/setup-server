# ShellCheck configuration for setup-server.
#
# CI gates at `-S warning` (see .github/workflows/ci.yml). Everything at
# warning level or above must stay green; the three codes below are disabled
# because each one is a structural false positive for this repo, not a bug we
# are papering over.

# SC1090: "can't follow non-constant source". Every setup.sh sources its
# per-service secrets file by variable path (`. "$ENV_FILE"`). The file is
# generated at deploy time and is gitignored, so there is nothing for
# ShellCheck to follow at lint time.
disable=SC1090

# SC2034: "variable appears unused". Fires on retry-loop counters
# (`for i in $(seq 1 30)`), on values exported into a heredoc or a `set -a`
# subshell that ShellCheck does not trace, and on a handful of genuinely
# unused bookkeeping variables that are harmless to keep.
disable=SC2034

# SC2120: "function references arguments, but none are ever passed". The test
# harnesses define helpers with optional arguments (`run_deploy "${1:-}"`) that
# some suites call bare and others call with input. That is deliberate.
disable=SC2120

# Deploy scripts source the shared helpers by a path relative to themselves
# (`. "$SERVICE_DIR/../../lib/common.sh"` under a
# `# shellcheck source=../../lib/common.sh` directive). SCRIPTDIR resolves that
# directive against the script's own folder, and external-sources lets
# ShellCheck follow it even when lib/common.sh is not among the files passed
# (the pre-commit hook lints only changed files).
source-path=SCRIPTDIR
external-sources=true
